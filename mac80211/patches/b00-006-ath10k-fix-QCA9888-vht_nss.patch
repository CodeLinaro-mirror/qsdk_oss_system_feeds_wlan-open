From 4f11a2ada15a1c36e5a8b24b4afe734f8f886ef5 Mon Sep 17 00:00:00 2001
From: Zhonglin Zhang <zhonglin@codeaurora.org>
Date: Tue, 20 Apr 2021 14:14:47 +0800
Subject: [PATCH 1/2] ath10k: fix wrong nss number because of endianness.
 
Change-Id: I2954b949cf1f8f7dab7dd9202d21ab820d5a187c
Signed-off-by: Zhonglin Zhang <zhonglin@codeaurora.org>
---
 drivers/net/wireless/ath/ath10k/mac.c    |  2 +-
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/drivers/net/wireless/ath/ath10k/mac.c b/drivers/net/wireless/ath/ath10k/mac.c
index fd63ebd..565755a 100644
--- a/drivers/net/wireless/ath/ath10k/mac.c
+++ b/drivers/net/wireless/ath/ath10k/mac.c
@@ -2486,7 +2486,7 @@ static void ath10k_peer_assoc_h_vht(struct ath10k *ar,
 	 * peer_assoc command id.
 	 */
 	for ( i = 0, max_nss = 0, vht_mcs = 0; i < NL80211_VHT_NSS_MAX; i++) {
-		vht_mcs = vht_cap->vht_mcs.rx_mcs_map >> (2 * i) & 3;
+		vht_mcs = __le16_to_cpu(vht_cap->vht_mcs.rx_mcs_map) >> (2 * i) & 3;
 
 		if ((vht_mcs != IEEE80211_VHT_MCS_NOT_SUPPORTED) &&
 		     vht_mcs_mask[i])
-- 
2.7.4

