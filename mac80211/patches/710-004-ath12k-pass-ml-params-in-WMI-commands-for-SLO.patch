From b6ed664f946dc41f3d89253a9c6ce666981e9ece Mon Sep 17 00:00:00 2001
From: Sriram R <quic_srirrama@quicinc.com>
Date: Wed, 7 Sep 2022 18:42:49 +0530
Subject: [PATCH 4/6] ath12k: pass ml params in WMI commands for SLO

Fill the vdev create/start, peer create/assoc commands
with ML params required for SLO.

Signed-off-by: Sriram R <quic_srirrama@quicinc.com>
---
 drivers/net/wireless/ath/ath12k/mac.c |  67 +++++++++++++-
 drivers/net/wireless/ath/ath12k/wmi.c | 126 +++++++++++++++++++++++---
 drivers/net/wireless/ath/ath12k/wmi.h |  89 ++++++++++++++++++
 3 files changed, 269 insertions(+), 13 deletions(-)

Index: backports-20220404-5.4.164-f40abb4788/drivers/net/wireless/ath/ath12k/mac.c
===================================================================
--- backports-20220404-5.4.164-f40abb4788.orig/drivers/net/wireless/ath/ath12k/mac.c	2022-12-20 14:11:46.159402228 +0530
+++ backports-20220404-5.4.164-f40abb4788/drivers/net/wireless/ath/ath12k/mac.c	2022-12-20 14:11:46.151402213 +0530
@@ -2954,6 +2954,53 @@ static void ath12k_peer_assoc_h_phymode(
 	WARN_ON(phymode == MODE_UNKNOWN);
 }
 
+static void ath12k_peer_assoc_h_mlo(struct ieee80211_sta *sta,
+				    struct peer_assoc_params *arg)
+{
+	struct peer_assoc_mlo_params *ml = &arg->ml;
+	struct ath12k_sta *arsta;
+	struct ath12k_peer *peer;
+	struct ath12k_base *ab;
+
+	arsta = (struct ath12k_sta *)sta->drv_priv;
+
+	if (!sta->is_mld)
+		return;
+
+	ab = arsta->arvif->ar->ab;
+
+	spin_lock_bh(&ab->base_lock);
+	peer = ath12k_peer_find_by_addr(ab, sta->link_addr);
+
+	if (!peer) {
+		spin_unlock_bh(&ab->base_lock);
+		return;
+	}
+
+	/* To keep things simple for SLO, use the same
+	 * link peer id as ML peer id
+	 */
+	ml->ml_peer_id = peer->peer_id;
+
+	spin_unlock_bh(&ab->base_lock);
+
+	/* For SLO below params are true */
+	ml->enabled = true;
+	ml->assoc_link = true;
+	ml->primary_umac = true;
+	ml->peer_id_valid = true;
+	ml->logical_link_idx_valid = true;
+
+	ether_addr_copy(&ml->mld_addr, sta->addr);
+
+	ath12k_dbg(ab, ATH12K_DBG_MAC, "sta mld addr %pM\n", ml->mld_addr);
+	/* currently using idx as 0 for SLO */
+	ml->logical_link_idx = 0;
+	ml->ieee_link_id = 0;
+
+	/* No partner info added for SLO */
+}
+
 static void ath12k_peer_assoc_prepare(struct ath12k *ar,
 				      struct ieee80211_vif *vif,
 				      struct ieee80211_sta *sta,
@@ -2983,6 +3030,9 @@ static void ath12k_peer_assoc_prepare(st
 	ath12k_peer_assoc_h_qos(ar, vif, sta, arg);
 	ath12k_peer_assoc_h_smps(sta, arg);
 
+	if (!reassoc)
+		ath12k_peer_assoc_h_mlo(sta, arg);
+
 	arsta->peer_nss = arg->peer_nss;
 
 	/* TODO: amsdu_disable req? */
@@ -5359,6 +5409,7 @@ static int ath12k_mac_station_add(struct
 	peer_param.vdev_id = arvif->vdev_id;
 	peer_param.peer_addr = sta->link_addr;
 	peer_param.peer_type = WMI_PEER_TYPE_DEFAULT;
+	peer_param.ml_enabled = sta->is_mld;
 
 	ret = ath12k_peer_create(ar, arvif, sta, &peer_param);
 	if (ret) {
@@ -7272,7 +7323,8 @@ static int ath12k_mac_setup_vdev_params_
 }
 
 static int ath12k_mac_setup_vdev_create_params(struct ath12k_vif *arvif,
-					       struct vdev_create_params *params)
+					       struct vdev_create_params *params,
+					       bool is_mld)
 {
 	struct ath12k *ar = arvif->ar;
 	struct ath12k_pdev *pdev = ar->pdev;
@@ -7310,6 +7362,11 @@ static int ath12k_mac_setup_vdev_create_
 	}
 
 	params->if_stats_id = ath12k_mac_get_vdev_stats_id(arvif);
+
+	/* for now, the assumption is the link and mld address are same */
+	if (is_mld)
+		ether_addr_copy(params->mld_addr, arvif->vif->addr);
+
 	return 0;
 }
 
@@ -7431,6 +7488,7 @@ static int ath12k_mac_vdev_create(struct
 	u16 nss;
 	int i;
 	int ret, vdev_id;
+	bool is_mld = false;
 
 	lockdep_assert_held(&ar->conf_mutex);
 
@@ -7465,6 +7523,7 @@ static int ath12k_mac_vdev_create(struct
 		fallthrough;
 	case NL80211_IFTYPE_AP:
 		arvif->vdev_type = WMI_VDEV_TYPE_AP;
+		is_mld = vif->bss_conf.eht_support;
 		break;
 	case NL80211_IFTYPE_MONITOR:
 		arvif->vdev_type = WMI_VDEV_TYPE_MONITOR;
@@ -7484,7 +7543,7 @@ static int ath12k_mac_vdev_create(struct
 	for (i = 0; i < ARRAY_SIZE(vif->hw_queue); i++)
 		vif->hw_queue[i] = i % (ATH12K_HW_MAX_QUEUES - 1);
 
-	ret = ath12k_mac_setup_vdev_create_params(arvif, &vdev_param);
+	ret = ath12k_mac_setup_vdev_create_params(arvif, &vdev_param, is_mld);
 	if (ret) {
 		ath12k_warn(ab, "failed to create vdev parameters %d: %d\n",
 			    arvif->vdev_id, ret);
@@ -8212,10 +8271,15 @@ ath12k_mac_vdev_start_restart(struct ath
 		spin_unlock_bh(&ab->base_lock);
 
 		/* TODO: Notify if secondary 80Mhz also needs radar detection */
+
+		/* Partner links are not filled for now */
+		if (!restart && arvif->vif->bss_conf.eht_support)
+			arg.ml.enabled = true;
 	}
 
 	arg.channel.passive |= !!(chandef->chan->flags & IEEE80211_CHAN_NO_IR);
 
+
 	ath12k_dbg(ab, ATH12K_DBG_MAC,
 		   "mac vdev %d start center_freq %d phymode %s\n",
 		   arg.vdev_id, arg.channel.freq,
Index: backports-20220404-5.4.164-f40abb4788/drivers/net/wireless/ath/ath12k/wmi.c
