diff --git a/drivers/net/wireless/ath/ath9k/main.c b/drivers/net/wireless/ath/ath9k/main.c
index 3acc748..fe09e5b 100644
--- a/drivers/net/wireless/ath/ath9k/main.c
+++ b/drivers/net/wireless/ath/ath9k/main.c
@@ -1209,6 +1209,7 @@ void ath9k_set_txpower(struct ath_softc *sc, struct ieee80211_vif *vif)
 	int power;
 	struct ath_hw *ah = sc->sc_ah;
 	struct ath_regulatory *reg = ath9k_hw_regulatory(ah);
+	bool chanctx_enabled = (vif && ath9k_is_chanctx_enabled());
 
 	ath9k_ps_wakeup(sc);
 	if (ah->tpc_enabled) {
@@ -1218,12 +1219,26 @@ void ath9k_set_txpower(struct ath_softc *sc, struct ieee80211_vif *vif)
 				ath9k_tpc_vif_iter, &power);
 		if (power == -1)
 			power = sc->hw->conf.power_level;
+	} else if (chanctx_enabled) {
+		power = vif->bss_conf.txpower;
 	} else {
 		power = sc->hw->conf.power_level;
 	}
-	sc->cur_chan->txpower = 2 * power;
-	ath9k_hw_set_txpowerlimit(ah, sc->cur_chan->txpower, false);
-	sc->cur_chan->cur_txpower = reg->max_power_level;
+
+	if (chanctx_enabled) {
+		struct ath_vif *avp = (struct ath_vif *)vif->drv_priv;
+		if (avp->chanctx) {
+			avp->chanctx->txpower = 2 * power;
+			if (sc->cur_chan == avp->chanctx)
+				ath9k_hw_set_txpowerlimit(ah, avp->chanctx->txpower, false);
+			avp->chanctx->cur_txpower = reg->max_power_level;
+		}
+
+	} else {
+		sc->cur_chan->txpower = 2 * power;
+		ath9k_hw_set_txpowerlimit(ah, sc->cur_chan->txpower, false);
+		sc->cur_chan->cur_txpower = reg->max_power_level;
+	}
 	ath9k_ps_restore(sc);
 }
 
@@ -2647,14 +2662,18 @@ static int ath9k_get_txpower(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 	struct ath_softc *sc = hw->priv;
 	struct ath_vif *avp = (void *)vif->drv_priv;
 
-	mutex_lock(&sc->mutex);
-	if (avp->chanctx)
-		*dbm = avp->chanctx->cur_txpower;
-	else
-		*dbm = sc->cur_chan->cur_txpower;
-	mutex_unlock(&sc->mutex);
+	if (!ath9k_is_chanctx_enabled()) {
+		mutex_lock(&sc->mutex);
+		if (avp->chanctx)
+			*dbm = avp->chanctx->cur_txpower;
+		else
+			*dbm = sc->cur_chan->cur_txpower;
+		mutex_unlock(&sc->mutex);
 
-	*dbm /= 2;
+		*dbm /= 2;
+	} else {
+		*dbm = vif->bss_conf.txpower;
+	}
 
 	return 0;
 }
