 };
 
 #define RX_HTT_HDR_STATUS_LEN 64
diff --git a/drivers/net/wireless/ath/ath10k/htt_rx.c b/drivers/net/wireless/ath/ath10k/htt_rx.c
index cf978e6..67dc4fa 100644
--- a/drivers/net/wireless/ath/ath10k/htt_rx.c
+++ b/drivers/net/wireless/ath/ath10k/htt_rx.c
@@ -188,8 +188,7 @@ static void ath10k_htt_rx_msdu_buff_replenish(struct ath10k_htt *htt)
 #ifndef CPTCFG_ATH10K_QCA4531_PERF
 	num_to_fill = min(ATH10K_HTT_MAX_NUM_REFILL, num_deficit);
 #else
-#define ATH10K_AR4531_HTT_MAX_NUM_REFILL 16
-	num_to_fill = min(ATH10K_AR4531_HTT_MAX_NUM_REFILL, num_deficit);
+	num_to_fill = min(htt->max_num_refill, num_deficit);
 #endif
 	num_deficit -= num_to_fill;
 	ret = ath10k_htt_rx_ring_fill_n(htt, num_to_fill);
@@ -520,6 +519,9 @@ int ath10k_htt_rx_alloc(struct ath10k_htt *htt)
 
 	spin_lock_init(&htt->rx_ring.lock);
 
+#ifdef CPTCFG_ATH10K_QCA4531_PERF
+	htt->max_num_refill = ATH10K_HTT_MAX_NUM_REFILL;
+#endif
 	htt->rx_ring.fill_cnt = 0;
 	htt->rx_ring.sw_rd_idx.msdu_payld = 0;
 	hash_init(htt->rx_ring.skb_table);
