From e2ff57ef86bcf9d897aa59453f1ba287f3c5a57b Mon Sep 17 00:00:00 2001
From: Aloka Dixit <quic_alokad@quicinc.com>
Date: Fri, 21 Jan 2022 10:14:48 -0800
Subject: [PATCH 13/14] ath11k: EMA beacon DTIM support

Signed-off-by: Aloka Dixit <quic_alokad@quicinc.com>
---
 drivers/net/wireless/ath/ath11k/mac.c | 69 +++++++++++++++++++++++----
 1 file changed, 61 insertions(+), 8 deletions(-)

diff --git a/drivers/net/wireless/ath/ath11k/mac.c b/drivers/net/wireless/ath/ath11k/mac.c
index a4c236a94a75..80fde073fca4 100644
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -1423,6 +1423,40 @@ err_mon_del:
 	return ret;
 }
 
+static void ath11k_mac_set_dtim_count(struct sk_buff *bcn, u32 bitmap)
+{
+	u8 *profile, *next_profile, profile_len;
+	u8 *ies;
+	struct ieee80211_mgmt *mgmt;
+	int ies_len;
+
+	ies = bcn->data + ieee80211_get_hdrlen_from_skb(bcn);
+	ies += sizeof(mgmt->u.beacon);
+	ies_len = skb_tail_pointer(bcn) - ies;
+
+	ies = cfg80211_find_ie(WLAN_EID_MULTIPLE_BSSID, ies, ies_len);
+	while (ies) {
+		ies_len -= (2 + ies[1]);
+		profile_len = ies[1] - 1;
+		profile = &ies[3];
+		while (profile_len) {
+			next_profile = profile + (2 + profile[1]);
+			profile_len -= (2 + profile[1]);
+
+			profile += (4 + profile[3]);
+			profile += (2 + profile[1]);
+
+			if (bitmap & BIT(profile[2]))
+				profile[4] = 0x00;
+
+			profile = next_profile;
+		}
+
+		ies = cfg80211_find_ie(WLAN_EID_MULTIPLE_BSSID, profile,
+				       ies_len);
+	}
+}
+
 static void ath11k_mac_setup_bcn_tmpl_vif_params(struct ath11k_vif *arvif,
 						 struct sk_buff *bcn)
 {
@@ -1548,7 +1582,7 @@ static int __ath11k_mac_setup_bcn_tmpl(struct ath11k_vif *arvif,
 	return ath11k_wmi_bcn_tmpl(ar, arvif->vdev_id, &offs, bcn, ema_param);
 }
 
-static int ath11k_mac_setup_bcn_tmpl_ema(struct ath11k_vif *arvif)
+static int ath11k_mac_setup_bcn_tmpl_ema(struct ath11k_vif *arvif, u32 bitmap)
 {
 	struct ath11k_vif *tx_arvif;
 	struct ieee80211_ema_beacons *beacons;
@@ -1584,6 +1618,9 @@ static int ath11k_mac_setup_bcn_tmpl_ema(struct ath11k_vif *arvif)
 									   arvif,
 									   beacons->bcn[i].skb);
 
+		if (bitmap)
+			ath11k_mac_set_dtim_count(beacons->bcn[i].skb, bitmap);
+
 		ret = __ath11k_mac_setup_bcn_tmpl(tx_arvif, beacons->bcn[i].skb,
 						  beacons->bcn[i].offs,
 						  i, beacons->cnt);
@@ -1600,7 +1637,8 @@ static int ath11k_mac_setup_bcn_tmpl_ema(struct ath11k_vif *arvif)
 }
 
 
-static int ath11k_mac_setup_bcn_tmpl_non_ema(struct ath11k_vif *arvif)
+static int ath11k_mac_setup_bcn_tmpl_non_ema(struct ath11k_vif *arvif,
+					     u32 bitmap)
 {
 	struct ath11k_vif *tx_arvif = arvif;
 	struct ieee80211_mutable_offsets offs = {};
@@ -1625,6 +1663,9 @@ static int ath11k_mac_setup_bcn_tmpl_non_ema(struct ath11k_vif *arvif)
 								  arvif,
 								  bcn);
 
+	if (bitmap)
+		ath11k_mac_set_dtim_count(bcn, bitmap);
+
 	ret = __ath11k_mac_setup_bcn_tmpl(tx_arvif, bcn, offs, 0, 0);
 	if (ret)
 		ath11k_warn(arvif->ar->ab,
@@ -1638,19 +1679,31 @@ static int ath11k_mac_setup_bcn_tmpl_non_ema(struct ath11k_vif *arvif)
 static int ath11k_mac_setup_bcn_tmpl(struct ath11k_vif *arvif)
 {
 	struct ieee80211_vif *vif = arvif->vif;
+	u32 bitmap = 0;
 
 	if (arvif->vdev_type != WMI_VDEV_TYPE_AP)
 		return 0;
 
-	if (vif->mbssid_tx_vif &&
-	    arvif != (void *)vif->mbssid_tx_vif->drv_priv &&
-	    arvif->is_up)
-		return 0;
+	if (vif->mbssid_tx_vif) {
+		struct ath11k_vif *tx_arvif, *temp;
+
+		tx_arvif = (void *)vif->mbssid_tx_vif->drv_priv;
+		if (arvif != tx_arvif && arvif->is_up)
+			return 0;
+
+		list_for_each_entry(temp, &tx_arvif->ar->arvifs, list) {
+			if (temp == tx_arvif)
+				continue;
+			if (temp->vif->mbssid_tx_vif == vif->mbssid_tx_vif &&
+			    temp->is_up)
+				bitmap |= BIT(temp->vif->bss_conf.bssid_index);
+		}
+	}
 
 	if (vif->bss_conf.ema_ap)
-		return ath11k_mac_setup_bcn_tmpl_ema(arvif);
+		return ath11k_mac_setup_bcn_tmpl_ema(arvif, bitmap);
 	else
-		return ath11k_mac_setup_bcn_tmpl_non_ema(arvif);
+		return ath11k_mac_setup_bcn_tmpl_non_ema(arvif, bitmap);
 }
 
 void ath11k_mac_bcn_tx_event(struct ath11k_vif *arvif)
-- 
