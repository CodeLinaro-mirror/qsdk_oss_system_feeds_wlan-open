From add4be90bd06bac9440e702b4cdc011c44bb1235 Mon Sep 17 00:00:00 2001
From: Aloka Dixit <alokad@codeaurora.org>
Date: Wed, 2 Oct 2019 12:07:37 -0700
Subject: [PATCH] Ath11k: Enable DEBUGFS for TWT support.

Signed-off-by: Aloka Dixit <alokad@codeaurora.org>
---
 drivers/net/wireless/ath/ath11k/debug.c | 2 +-
 drivers/net/wireless/ath/ath11k/debug.h | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/ath/ath11k/debug.c b/drivers/net/wireless/ath/ath11k/debug.c
index 9b7c89cd2aea..d9f1001e7cb2 100644
--- a/drivers/net/wireless/ath/ath11k/debug.c
+++ b/drivers/net/wireless/ath/ath11k/debug.c
@@ -144,7 +144,7 @@ void ath11k_dbg_dump(struct ath11k_base *ab,
 
 #endif
 
-#ifdef CONFIG_MAC80211_DEBUGFS
+#ifdef CPTCFG_MAC80211_DEBUGFS
 static ssize_t ath11k_write_twt_add_dialog(struct file *file,
 		const char __user *ubuf,
 		size_t count, loff_t *ppos)
diff --git a/drivers/net/wireless/ath/ath11k/debug.h b/drivers/net/wireless/ath/ath11k/debug.h
index bc6e20788897..d3d22b4ad21b 100644
--- a/drivers/net/wireless/ath/ath11k/debug.h
+++ b/drivers/net/wireless/ath/ath11k/debug.h
@@ -140,7 +140,7 @@ static inline void ath11k_dbg_dump(struct ath11k_base *ab,
 }
 #endif /* CPTCFG_ATH11K_DEBUG */
 
-#ifdef CONFIG_MAC80211_DEBUGFS
+#ifdef CPTCFG_MAC80211_DEBUGFS
 void ath11k_debugfs_twt(struct ath11k_vif *arvif, bool enable);
 #else
 static inline void ath11k_debugfs_twt(struct ath11k_vif *arvif, bool enable)
-- 
2.7.4

