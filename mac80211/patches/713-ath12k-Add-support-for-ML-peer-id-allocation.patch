+++ b/drivers/net/wireless/ath/ath12k/peer.h	2023-02-17 13:27:40.032374094 +0530
@@ -51,6 +51,7 @@ struct ath12k_peer {
 	 */
 	bool dp_setup_done;
 	bool is_ml_peer;
+	u16 ml_peer_id;
 };
 
 void ath12k_peer_unmap_event(struct ath12k_base *ab, u16 peer_id);
