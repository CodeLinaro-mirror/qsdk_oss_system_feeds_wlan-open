+static void ath10k_mac_txq_push(struct ieee80211_hw *hw,
+				struct ieee80211_txq *txq)
+{
+	struct ath10k *ar = hw->priv;
+	struct ath10k_htt *htt = &ar->htt;
+	struct ath10k_txq *artxq = (void *)txq->drv_priv;
+	struct ieee80211_vif *vif = txq->vif;
+	struct ieee80211_sta *sta = txq->sta;
+	enum ath10k_hw_txrx_mode txmode;
+	enum ath10k_mac_tx_path txpath;
+	struct sk_buff *skb;
+	bool is_mgmt = false;
+	bool is_presp = false;
+	int ret;
+
+	lockdep_assert_held(&ar->pending_txqs_lock);
+
+	for (;;) {
+		spin_lock_bh(&ar->htt.tx_lock);
+
+		ret = ath10k_htt_tx_inc_pending(htt, is_mgmt, is_presp);
+		if (ret) {
+			if (list_empty(&artxq->pending) && txq->qdepth > 0)
+				list_move_tail(&artxq->pending,
+					       &ar->pending_txqs);
+			spin_unlock_bh(&ar->htt.tx_lock);
+			break;
+		}
+
+		spin_unlock_bh(&ar->htt.tx_lock);
+
+		skb = ieee80211_tx_dequeue(hw, txq);
+		if (!skb) {
+			spin_lock_bh(&ar->htt.tx_lock);
+			if (!list_empty(&artxq->pending))
+				list_del_init(&artxq->pending);
+			ath10k_htt_tx_dec_pending(htt, is_mgmt);
+			spin_unlock_bh(&ar->htt.tx_lock);
+			break;
+		}
+
+		ath10k_mac_tx_h_fill_cb(ar, txq, skb);
+
+		txmode = ath10k_mac_tx_h_get_txmode(ar, vif, sta, skb);
+		txpath = ath10k_mac_tx_h_get_txpath(ar, skb, txmode);
+
+		ret = ath10k_mac_tx(ar, vif, sta, txmode, txpath, skb);
+		if (ret) {
+			ath10k_warn(ar, "failed to transmit queued frame: %d\n",
+				    ret);
+			spin_lock_bh(&ar->htt.tx_lock);
+			ath10k_htt_tx_dec_pending(htt, is_mgmt);
+			spin_unlock_bh(&ar->htt.tx_lock);
+			continue;
+		}
+	}
+}
+
+void ath10k_mac_txq_push_pending(struct ath10k *ar)
+{
+	struct ieee80211_hw *hw = ar->hw;
+	struct ieee80211_txq *txq;
+	struct ath10k_txq *artxq, *tmp;
+	struct list_head list;
+
+	INIT_LIST_HEAD(&list);
+
+	rcu_read_lock();
+	spin_lock_bh(&ar->pending_txqs_lock);
+
+	/* FIXME: This can probably be simplified/optimized */
+
+	list_for_each_entry_safe(artxq, tmp, &ar->pending_txqs, pending) {
+		txq = container_of((void *)artxq, struct ieee80211_txq,
+				   drv_priv);
+		list_move_tail(&artxq->pending, &list);
+	}
+
+	list_for_each_entry_safe(artxq, tmp, &list, pending) {
+		txq = container_of((void *)artxq, struct ieee80211_txq,
+				   drv_priv);
+		list_del_init(&artxq->pending);
+		ath10k_mac_txq_push(hw, txq);
+	}
+
+	spin_unlock_bh(&ar->pending_txqs_lock);
+	rcu_read_unlock();
+}
+
+static void ath10k_mac_txq_cleanup(struct ath10k *ar,
+				   struct ieee80211_txq *txq)
+{
+	struct ath10k_skb_cb *cb;
+	struct sk_buff *msdu;
+	int msdu_id;
+
+	lockdep_assert_held(&ar->htt.tx_lock);
+
+	idr_for_each_entry(&ar->htt.pending_tx, msdu, msdu_id) {
+		cb = ATH10K_SKB_CB(msdu);
+		if (cb->txq == txq)
+			cb->txq = NULL;
+	}
+}
