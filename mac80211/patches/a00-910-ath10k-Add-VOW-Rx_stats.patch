+static void ath10k_rx_vow_stats_ampdu_update(struct ath10k *ar,
+					     struct ath10k_sta *arsta,
+					     u32 mpdu_count)
+{
+	struct ath10k_vow_stats *stats = &arsta->vow_stats;
+
+	if (mpdu_count <= 10)
+		stats->rx_pkt_ampdu[ATH10K_VOW_STATS_AMPDU_10]++;
+	else if (mpdu_count <= 20)
+		stats->rx_pkt_ampdu[ATH10K_VOW_STATS_AMPDU_20]++;
+	else if (mpdu_count <= 30)
+		stats->rx_pkt_ampdu[ATH10K_VOW_STATS_AMPDU_30]++;
+	else if (mpdu_count <= 40)
+		stats->rx_pkt_ampdu[ATH10K_VOW_STATS_AMPDU_40]++;
+	else if (mpdu_count <= 50)
+		stats->rx_pkt_ampdu[ATH10K_VOW_STATS_AMPDU_50]++;
+	else if (mpdu_count <= 60)
+		stats->rx_pkt_ampdu[ATH10K_VOW_STATS_AMPDU_60]++;
+	else if (mpdu_count > 60)
+		stats->rx_pkt_ampdu[ATH10K_VOW_STATS_AMPDU_MORE]++;
+}
+
+static void ath10k_rx_vow_stats_amsdu_update(struct ath10k *ar,
