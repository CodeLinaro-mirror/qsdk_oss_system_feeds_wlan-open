diff --git a/net/mac80211/cfg.c b/net/mac80211/cfg.c
index 1df05e6..b8a3f11 100644
--- a/net/mac80211/cfg.c
+++ b/net/mac80211/cfg.c
@@ -1331,7 +1331,9 @@ static int sta_apply_parameters(struct ieee80211_local *local,
 	int ret = 0;
 	struct ieee80211_supported_band *sband;
 	struct ieee80211_sub_if_data *sdata = sta->sdata;
-	u32 mask, set;
+	u32 mask, set, tid, ac;
+	bool ac_synced[IEEE80211_NUM_ACS] = {false};
+	struct txq_info *txqi;
 
 	sband = ieee80211_get_sband(sdata);
 	if (!sband)
@@ -1499,8 +1501,33 @@ static int sta_apply_parameters(struct ieee80211_local *local,
 	if (ieee80211_vif_is_mesh(&sdata->vif))
 		sta_apply_mesh_params(local, sta, params);
 
-	if (params->airtime_weight)
+	if (params->airtime_weight) {
+		for (tid = 0;tid < IEEE80211_NUM_TIDS + 1;tid++) {
+
+			if (params->airtime_weight == sta->airtime_weight)
+				break;
+
+			ac = ieee80211_ac_from_tid(tid);
+			if (!sta->sta.txq[tid] || ac_synced[ac])
+				continue;
+
+			spin_lock_bh(&local->active_txq_lock[ac]);
+
+			txqi = to_txq_info(sta->sta.txq[tid]);
+			if (RB_EMPTY_NODE(&txqi->schedule_order)) {
+				spin_unlock_bh(&local->active_txq_lock[ac]);
+				continue;
+			}
+
+			local->airtime_weight_sum[ac] = local->airtime_weight_sum[ac] +
+											params->airtime_weight -
+											sta->airtime_weight;
+			ac_synced[ac] = true;
+
+			spin_unlock_bh(&local->active_txq_lock[ac]);
+		}
 		sta->airtime_weight = params->airtime_weight;
+	}
 
 	/* set the STA state after all sta info from usermode has been set */
 	if (test_sta_flag(sta, WLAN_STA_TDLS_PEER) ||
