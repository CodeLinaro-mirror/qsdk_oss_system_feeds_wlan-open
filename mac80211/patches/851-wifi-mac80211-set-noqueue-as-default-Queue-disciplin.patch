From 1e1b8e74482fdcdec8acdb8227b0806171e76cb0 Mon Sep 17 00:00:00 2001
From: Hari Chandrakanthan <quic_haric@quicinc.com>
Date: Thu, 2 Nov 2023 11:24:02 +0530
Subject: [PATCH] wifi: mac80211: set noqueue as default Queue discipline

To avoid high memory consumption, set noqueue
as default queue discipline for wifi interfaces.

Signed-off-by: Hari Chandrakanthan <quic_haric@quicinc.com>
---
 net/mac80211/iface.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/net/mac80211/iface.c b/net/mac80211/iface.c
index 056104c..79734cb 100644
--- a/net/mac80211/iface.c
+++ b/net/mac80211/iface.c
@@ -1739,6 +1739,7 @@ static void ieee80211_if_setup(struct net_device *dev)
 {
 	ether_setup(dev);
 	dev->priv_flags &= ~IFF_TX_SKB_SHARING;
+	dev->priv_flags |= IFF_NO_QUEUE;
 	dev->netdev_ops = &ieee80211_dataif_ops;
 	netdev_set_priv_destructor(dev, ieee80211_if_free);
 }
@@ -2428,6 +2429,8 @@ int ieee80211_if_add(struct ieee80211_local *local, const char *name,
 		ether_addr_copy(sdata->vif.bss_conf.addr, sdata->vif.addr);
 		memcpy(sdata->name, ndev->name, IFNAMSIZ);
 
+		sdata->vif.noqueue_enable = 1;
+
 		if (txq_size) {
 			txqi = netdev_priv(ndev) + size;
 			ieee80211_txq_init(sdata, NULL, txqi, 0);
-- 
2.34.1

