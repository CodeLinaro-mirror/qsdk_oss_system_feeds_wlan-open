 };
 
 static int nl80211_set_tid_config(struct sk_buff *skb,
@@ -12603,6 +12604,7 @@ static int nl80211_set_tid_config(struct sk_buff *skb,
 	const char *peer = NULL;
 	u8 tid_no;
 	int ret = -EINVAL, retry_short = -1, retry_long = -1;
+	bool aggr;
 
 	tid = info->attrs[NL80211_ATTR_TID_CONFIG];
 	if (!tid)
@@ -12658,6 +12660,20 @@ static int nl80211_set_tid_config(struct sk_buff *skb,
