diff --git a/net/wireless/core.c b/net/wireless/core.c
index de647e2ea63d..9e1f7a7036a8 100644
--- a/net/wireless/core.c
+++ b/net/wireless/core.c
@@ -66,6 +66,8 @@ EXPORT_SYMBOL(g_bonded_interface_model);
 int (*driver_bond_dev_cb)(struct wireless_dev *wdev, struct net_device *dev, bool is_register);
 EXPORT_SYMBOL(driver_bond_dev_cb);
 #endif
+void (*driver_rfs_vp_cleanup_cb)(struct net_device *dev, int ppe_vp_num);
+EXPORT_SYMBOL(driver_rfs_vp_cleanup_cb);
 
 struct cfg80211_registered_device *cfg80211_rdev_by_wiphy_idx(int wiphy_idx)
 {
@@ -1412,9 +1414,25 @@ static void _cfg80211_unregister_wdev(struct wireless_dev *wdev,
 
 	if (wdev->netdev) {
 		sysfs_remove_link(&wdev->netdev->dev.kobj, "phy80211");
-		if (unregister_netdev)
+		if (unregister_netdev) {
+			/* NOTE: PPE driver expects ppe_vp_free to be done only after
+			 * interface removal from  bridge and flow rule cleanup.
+			 * Currently this is achieved only through NETDEV_UNREGISTER due
+			 * to lack of syncronous flow rule cleanup APIs.
+			 * This holds reference to netdevice until ppe_vp_free is done.
+			 */
+			dev_hold(wdev->netdev);
+
 			unregister_netdevice(wdev->netdev);
 
+			if (*driver_rfs_vp_cleanup_cb && wdev->ppe_rfs_num > 0)
+				(*driver_rfs_vp_cleanup_cb)(wdev->netdev, wdev->ppe_rfs_num);
+
+			wdev->ppe_rfs_num = 0;
+			/* release any taken netdev reference for netdev cleanup */
+			dev_put(wdev->netdev);
+		}
+
 #ifdef CPTCFG_MAC80211_BONDED_SUPPORT
 		if (wdev->bond_netdev) {
 			if (wdev->iftype == NL80211_IFTYPE_MESH_POINT ||
