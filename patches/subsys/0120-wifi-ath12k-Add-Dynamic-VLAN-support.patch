From 64c7e3b72606dbfff02a49c3c23ecb50d361ad34 Mon Sep 17 00:00:00 2001
From: Balamurugan Ramar <quic_bramar@quicinc.com>
Date: Thu, 10 Apr 2025 23:26:14 +0530
Subject: [PATCH] mac80211: wifi athk Add Dynamic VLAN support

Add support for dynamic VLAN. VLAN group traffic is encrypted in
mac80211 and driver needs to add metadata for the SW encrypted vlan group
traffic.

Signed-off-by: Muna Sinada <quic_msinada@quicinc.com>
Signed-off-by: Balamurugan Ramar <quic_bramar@quicinc.com>
---
 net/mac80211/chan.c    |  5 +++++
 net/mac80211/tx.c      | 11 +++++++++--
 net/wireless/nl80211.c |  2 +-
 3 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/net/mac80211/chan.c b/net/mac80211/chan.c
index 3310f68..f608d85 100644
--- a/net/mac80211/chan.c
+++ b/net/mac80211/chan.c
@@ -2182,6 +2182,11 @@ void ieee80211_link_vlan_copy_chanctx(struct ieee80211_link_data *link)
 	conf = wiphy_dereference(local->hw.wiphy,
 				 ap_conf->chanctx_conf);
 	rcu_assign_pointer(link_conf->chanctx_conf, conf);
+
+	memcpy(&sdata->vif.link_conf[link_id]->chanreq.oper,
+	       &ap->vif.link_conf[link_id]->chanreq.oper,
+	       sizeof(struct cfg80211_chan_def));
+
 }
 
 void ieee80211_iter_chan_contexts_atomic(
diff --git a/net/mac80211/tx.c b/net/mac80211/tx.c
index 1cfdaf3..cffe4d1 100644
--- a/net/mac80211/tx.c
+++ b/net/mac80211/tx.c
@@ -2703,8 +2703,15 @@ static struct sk_buff *ieee80211_build_hdr(struct ieee80211_sub_if_data *sdata,
 			ap_sdata = container_of(sdata->bss,
 						struct ieee80211_sub_if_data,
 						u.ap);
-			chanctx_conf =
-				rcu_dereference(ap_sdata->vif.bss_conf.chanctx_conf);
+
+			/* TODO: change index of link_conf[] to link id of corresponding
+			 * AP for MLO cases */
+			if (ap_sdata->vif.valid_links)
+				chanctx_conf =
+				 rcu_dereference(ap_sdata->vif.link_conf[0]->chanctx_conf);
+			else
+				chanctx_conf =
+				 rcu_dereference(ap_sdata->vif.bss_conf.chanctx_conf);
 		}
 		if (sdata->wdev.use_4addr)
 			break;
diff --git a/net/wireless/nl80211.c b/net/wireless/nl80211.c
index e3ead06..c70edbc 100644
--- a/net/wireless/nl80211.c
+++ b/net/wireless/nl80211.c
@@ -4872,7 +4872,7 @@ static int nl80211_validate_key_link_id(struct genl_info *info,
 			GENL_SET_ERR_MSG(info, "invalid link ID for MLO group key");
 			return -EINVAL;
 		}
-	} else if (link_id != -1) {
+	} else if (link_id != -1 && wdev->iftype != NL80211_IFTYPE_AP_VLAN) {
 		GENL_SET_ERR_MSG(info, "link ID not allowed for non-MLO group key");
 		return -EINVAL;
 	}
-- 
2.34.1

