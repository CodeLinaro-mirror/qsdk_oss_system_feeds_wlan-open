+void wil_cfg80211_ap_recovery(struct wil6210_priv *wil)
+{
+	int rc;
+	struct wiphy *wiphy = wil_to_wiphy(wil);
+	struct net_device *ndev = wil_to_ndev(wil);
+	struct cfg80211_beacon_data bcon = {};
+	struct key_params key_params = {};
+
+	if (wil->ssid_len == 0)
+		return;
+
+	bcon.proberesp_ies = wil->proberesp_ies;
+	bcon.assocresp_ies = wil->assocresp_ies;
+	bcon.probe_resp = wil->proberesp;
+	bcon.proberesp_ies_len = wil->proberesp_ies_len;
+	bcon.assocresp_ies_len = wil->assocresp_ies_len;
+	bcon.probe_resp_len = wil->proberesp_len;
+
+	wil_info(wil,
+		 "AP recovery: privacy %d, bi %d, channel %d, hidden %d, pbss %d\n",
+		 wil->privacy, wil->bi, wil->channel,
+		 wil->hidden_ssid, wil->pbss);
+	wil_hex_dump_misc("SSID ", DUMP_PREFIX_OFFSET, 16, 1,
+			  wil->ssid, wil->ssid_len, true);
+	rc = _wil_cfg80211_start_ap(wiphy, ndev,
+				    wil->ssid, wil->ssid_len,
+				    wil->privacy, wil->bi,
+				    wil->channel, &bcon,
+				    wil->hidden_ssid, wil->pbss);
+	if (rc) {
+		wil_err(wil, "AP recovery failed (%d)\n", rc);
+		return;
+	}
+
+	if (!wil->privacy || wil->gtk_len == 0)
+		return;
+
+	key_params.key = wil->gtk;
+	key_params.key_len = wil->gtk_len;
+	key_params.seq_len = IEEE80211_GCMP_PN_LEN;
+	rc = wil_cfg80211_add_key(wiphy, ndev, wil->gtk_index, false,
+				  NULL, &key_params);
+	if (rc)
+		wil_err(wil, "AP recovery add key failed (%d)\n", rc);
+}
