+				 arsta->tx_stats.succ_pkts_nss[i]);
+	len += scnprintf(buf + len, size - len, "\nRetry packets:  \t");
+	for (i = 0; i < VHT_NSS_NUM; i++)
+		len += scnprintf(buf + len, size - len, "%llu\t",
+				 arsta->tx_stats.retry_pkts_nss[i]);
+	len += scnprintf(buf + len, size - len, "\nFailed packets: \t");
+	for (i = 0; i < VHT_NSS_NUM; i++)
