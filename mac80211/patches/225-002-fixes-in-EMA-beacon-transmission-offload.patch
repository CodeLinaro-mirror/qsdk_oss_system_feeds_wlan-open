-
-		if (test_bit(WMI_TLV_SERVICE_MBSS_PARAM_IN_VDEV_START_SUPPORT,
-			     ar->ab->wmi_ab.svc_map)) {
-			cmd->mbss_capability_flags = arg->mbss_capability_flags;
-			cmd->vdevid_trans = arg->vdevid_trans;
