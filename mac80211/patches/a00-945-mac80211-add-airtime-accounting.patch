 drivers/net/wireless/ath/ath10k/core.h   |   6 +-
 drivers/net/wireless/ath/ath10k/htt_rx.c |   8 +++
 drivers/net/wireless/ath/ath10k/mac.c    | 100 ++++++++++++++-----------------
 4 files changed, 55 insertions(+), 61 deletions(-)

