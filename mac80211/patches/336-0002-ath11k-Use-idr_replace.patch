From 93abe1755de2727bf8fb5969bce25ae49c704484 Mon Sep 17 00:00:00 2001
From: Tamizh Chelvam <quic_tamizhr@quicinc.com>
Date: Mon, 15 Nov 2021 18:15:38 +0530
Subject: [PATCH] ath11k: Use idr_replace

idr_alloc has been done multiple times upon reaping the msdu
using idr_remove. This idr_alloc would take more cpu, to redue
the cpu usage call idr_replace by storing used buf_ids instead
of calling idr_alloc during replenish.

Signed-off-by: Tamizh Chelvam <quic_tamizhr@quicinc.com>
---
 drivers/net/wireless/ath/ath11k/core.h  |  6 +++
 drivers/net/wireless/ath/ath11k/dp.c    |  2 +-
 drivers/net/wireless/ath/ath11k/dp_rx.c | 66 +++++++++++++++++++++++++--------
 drivers/net/wireless/ath/ath11k/dp_rx.h |  2 +-
 4 files changed, 59 insertions(+), 17 deletions(-)

--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -704,6 +704,11 @@ enum coex_algo {
 	COEX_ALGO_MAX_SUPPORTED,
 };
 
+struct ath11k_rx_buf_id {
+	struct list_head list;
+	int used_buf_id;
+};
+
 struct ath11k {
 	struct ath11k_base *ab;
 	struct ath11k_pdev *pdev;
@@ -864,6 +869,7 @@ struct ath11k {
 	enum wmi_phy_mode cfr_phymode;
 
 	struct ath11k_smart_ant_info smart_ant_info;
+	struct ath11k_rx_buf_id rx_buf_id;
 	u32 rx_antenna;
 };
 
--- a/drivers/net/wireless/ath/ath11k/dp.c
+++ b/drivers/net/wireless/ath/ath11k/dp.c
@@ -985,7 +985,7 @@ int ath11k_dp_service_srng(struct ath11k
 
 				ath11k_dp_rxbufs_replenish(ab, id, rx_ring, 0,
 							   HAL_RX_BUF_RBM_SW3_BM,
-							   GFP_ATOMIC);
+							   GFP_ATOMIC, NULL);
 			}
 		}
 	}
--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
@@ -370,9 +370,10 @@ int ath11k_dp_rxbufs_replenish(struct at
 			       struct dp_rxdma_ring *rx_ring,
 			       int req_entries,
 			       enum hal_rx_buf_return_buf_manager mgr,
-			       gfp_t gfp)
+			       gfp_t gfp, struct list_head *buf_id_list)
 {
 	struct hal_srng *srng;
+	struct ath11k_rx_buf_id *rx_buf_id;
 	u32 *desc;
 	struct sk_buff *skb;
 	int num_free;
@@ -415,10 +416,18 @@ int ath11k_dp_rxbufs_replenish(struct at
 		if (dma_mapping_error(ab->dev, paddr))
 			goto fail_free_skb;
 
-		spin_lock_bh(&rx_ring->idr_lock);
-		buf_id = idr_alloc(&rx_ring->bufs_idr, skb, 0,
-				   rx_ring->bufs_max * 3, GFP_ATOMIC);
-		spin_unlock_bh(&rx_ring->idr_lock);
+		if (!buf_id_list || list_empty(buf_id_list)) {
+			spin_lock_bh(&rx_ring->idr_lock);
+			buf_id = idr_alloc(&rx_ring->bufs_idr, skb, 0,
+					   rx_ring->bufs_max * 3, GFP_ATOMIC);
+			spin_unlock_bh(&rx_ring->idr_lock);
+		} else {
+			rx_buf_id = list_first_entry(buf_id_list, typeof(*rx_buf_id), list);
+			idr_replace(&rx_ring->bufs_idr, skb, rx_buf_id->used_buf_id);
+			buf_id = rx_buf_id->used_buf_id;
+			list_del(&rx_buf_id->list);
+			kfree(rx_buf_id);
+		}
 		if (buf_id < 0)
 			goto fail_dma_unmap;
 
@@ -514,7 +523,7 @@ static int ath11k_dp_rxdma_ring_buf_setu
 
 	rx_ring->bufs_max = num_entries;
 	ath11k_dp_rxbufs_replenish(ar->ab, dp->mac_id, rx_ring, num_entries,
-				   HAL_RX_BUF_RBM_SW3_BM, GFP_KERNEL);
+				   HAL_RX_BUF_RBM_SW3_BM, GFP_KERNEL, NULL);
 	return 0;
 }
 
@@ -3279,10 +3288,13 @@ int ath11k_dp_process_rx(struct ath11k_b
 	struct ath11k *ar;
 	struct hal_reo_dest_ring *desc;
 	enum hal_reo_dest_ring_push_reason push_reason;
+	struct ath11k_rx_buf_id *rx_buf_id, *tmp;
+	struct list_head buf_id_list;
 	u32 cookie;
 	int i;
 
 
+	INIT_LIST_HEAD(&buf_id_list);
 	for (i = 0; i < MAX_RADIOS; i++)
 		__skb_queue_head_init(&msdu_list[i]);
 	srng = &ab->hal.srng_list[dp->reo_dst_ring[ring_id].ring_id];
@@ -3302,13 +3314,17 @@ try_again:
 		ar = ab->pdevs[mac_id].ar;
 		rx_ring = &ar->dp.rx_refill_buf_ring;
 		spin_lock_bh(&rx_ring->idr_lock);
-		msdu = idr_remove(&rx_ring->bufs_idr, buf_id);
+		msdu = idr_find(&rx_ring->bufs_idr, buf_id);
+
 		spin_unlock_bh(&rx_ring->idr_lock);
 		if (unlikely(!msdu)) {
 			ath11k_warn(ab, "frame rx with invalid buf_id %d\n",
 				    buf_id);
 			continue;
 		}
+		rx_buf_id = kzalloc(sizeof(*rx_buf_id), GFP_ATOMIC);
+		rx_buf_id->used_buf_id = buf_id;
+		list_add_tail(&rx_buf_id->list, &buf_id_list);
 
 		rxcb = ATH11K_SKB_RXCB(msdu);
 
@@ -3394,7 +3410,14 @@ try_again:
 		rx_ring = &ar->dp.rx_refill_buf_ring;
 
 		ath11k_dp_rxbufs_replenish(ab, i, rx_ring, num_buffs_reaped[i],
-					   HAL_RX_BUF_RBM_SW3_BM, GFP_ATOMIC);
+					   HAL_RX_BUF_RBM_SW3_BM, GFP_ATOMIC, &buf_id_list);
+	}
+	if (!list_empty(&buf_id_list)) {
+		list_for_each_entry_safe(rx_buf_id, tmp, &buf_id_list, list) {
+			idr_remove(&rx_ring->bufs_idr, rx_buf_id->used_buf_id);
+			list_del(&rx_buf_id->list);
+			kfree(rx_buf_id);
+		}
 	}
 
 exit:
@@ -4819,7 +4842,7 @@ exit:
 		rx_ring = &ar->dp.rx_refill_buf_ring;
 
 		ath11k_dp_rxbufs_replenish(ab, i, rx_ring, n_bufs_reaped[i],
-					   HAL_RX_BUF_RBM_SW3_BM, GFP_ATOMIC);
+					   HAL_RX_BUF_RBM_SW3_BM, GFP_ATOMIC, NULL);
 	}
 
 	return tot_n_bufs_reaped;
@@ -5050,6 +5073,8 @@ int ath11k_dp_rx_process_wbm_err(struct
 	struct sk_buff *msdu;
 	struct sk_buff_head msdu_list[MAX_RADIOS];
 	struct ath11k_skb_rxcb *rxcb;
+	struct list_head wbm_err_id_list;
+	struct ath11k_rx_buf_id *rx_buf_id, *tmp;
 	u32 *rx_desc;
 	int buf_id, mac_id;
 	int num_buffs_reaped[MAX_RADIOS] = {0};
@@ -5059,6 +5084,7 @@ int ath11k_dp_rx_process_wbm_err(struct
 	for (i = 0; i < ab->num_radios; i++)
 		__skb_queue_head_init(&msdu_list[i]);
 
+	INIT_LIST_HEAD(&wbm_err_id_list);
 	srng = &ab->hal.srng_list[dp->rx_rel_ring.ring_id];
 
 	spin_lock_bh(&srng->lock);
@@ -5085,13 +5111,16 @@ int ath11k_dp_rx_process_wbm_err(struct
 		rx_ring = &ar->dp.rx_refill_buf_ring;
 
 		spin_lock_bh(&rx_ring->idr_lock);
- 		msdu = idr_remove(&rx_ring->bufs_idr, buf_id);
+ 		msdu = idr_find(&rx_ring->bufs_idr, buf_id);
 		spin_unlock_bh(&rx_ring->idr_lock);
 		if (!msdu) {
 			ath11k_warn(ab, "frame rx with invalid buf_id %d pdev %d\n",
 				    buf_id, mac_id);
 			continue;
 		}
+		rx_buf_id = kzalloc(sizeof(*rx_buf_id), GFP_ATOMIC);
+		rx_buf_id->used_buf_id = buf_id;
+		list_add_tail(&rx_buf_id->list, &wbm_err_id_list);
 
 		rxcb = ATH11K_SKB_RXCB(msdu);
 
@@ -5130,7 +5159,14 @@ int ath11k_dp_rx_process_wbm_err(struct
 		rx_ring = &ar->dp.rx_refill_buf_ring;
 
 		ath11k_dp_rxbufs_replenish(ab, i, rx_ring, num_buffs_reaped[i],
-					   HAL_RX_BUF_RBM_SW3_BM, GFP_ATOMIC);
+					   HAL_RX_BUF_RBM_SW3_BM, GFP_ATOMIC, &wbm_err_id_list);
+	}
+	if (!list_empty(&wbm_err_id_list)) {
+		list_for_each_entry_safe(rx_buf_id, tmp, &wbm_err_id_list, list) {
+			idr_remove(&rx_ring->bufs_idr, rx_buf_id->used_buf_id);
+			list_del(&rx_buf_id->list);
+			kfree(rx_buf_id);
+		}
 	}
 
 	rcu_read_lock();
@@ -5237,7 +5273,7 @@ int ath11k_dp_process_rxdma_err(struct a
 
 	if (num_buf_freed)
 		ath11k_dp_rxbufs_replenish(ab, mac_id, rx_ring, num_buf_freed,
-					   HAL_RX_BUF_RBM_SW3_BM, GFP_ATOMIC);
+					   HAL_RX_BUF_RBM_SW3_BM, GFP_ATOMIC, NULL);
 
 	return budget - quota;
 }
@@ -6247,12 +6283,12 @@ void ath11k_dp_rx_mon_dest_process(struc
 			ath11k_dp_rxbufs_replenish(ar->ab, dp->mac_id,
 						   &dp->rxdma_mon_buf_ring,
 						   rx_bufs_used,
-						   HAL_RX_BUF_RBM_SW3_BM, GFP_ATOMIC);
+						   HAL_RX_BUF_RBM_SW3_BM, GFP_ATOMIC, NULL);
 		else
 			ath11k_dp_rxbufs_replenish(ar->ab, dp->mac_id,
 						   &dp->rx_refill_buf_ring,
 						   rx_bufs_used,
-						   HAL_RX_BUF_RBM_SW3_BM, GFP_ATOMIC);
+						   HAL_RX_BUF_RBM_SW3_BM, GFP_ATOMIC, NULL);
 	}
 }
 
@@ -6785,7 +6821,7 @@ next_entry:
 		ath11k_dp_rxbufs_replenish(ar->ab, dp->mac_id,
 					   &dp->rxdma_mon_buf_ring,
 					   rx_bufs_used,
-					   HAL_RX_BUF_RBM_SW3_BM, GFP_ATOMIC);
+					   HAL_RX_BUF_RBM_SW3_BM, GFP_ATOMIC, NULL);
 	}
 
 reap_status_ring:
--- a/drivers/net/wireless/ath/ath11k/dp_rx.h
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.h
@@ -126,7 +126,7 @@ int ath11k_dp_rxbufs_replenish(struct at
 			       struct dp_rxdma_ring *rx_ring,
 			       int req_entries,
 			       enum hal_rx_buf_return_buf_manager mgr,
-			       gfp_t gfp);
+			       gfp_t gfp, struct list_head *buf_id_list);
 int ath11k_dp_htt_tlv_iter(struct ath11k_base *ab, const void *ptr, size_t len,
 			   int (*iter)(struct ath11k_base *ar, u16 tag, u16 len,
 				       const void *ptr, void *data),
