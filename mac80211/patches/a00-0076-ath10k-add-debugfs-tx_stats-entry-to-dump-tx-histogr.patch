+				 arsta->tx_stats.retry_bytes_nss[i]);
+	len += scnprintf(buf + len, size - len, "\nFailed bytes: \t\t");
+	for (i = 0; i < VHT_NSS_NUM; i++)
+		len += scnprintf(buf + len, size - len, "%llu\t",
+				 arsta->tx_stats.fail_bytes_nss[i]);
+	len += scnprintf(buf + len, size - len, "\ntotal bytes:  \t\t");
+	for (i = 0; i < VHT_NSS_NUM; i++)
+		len += scnprintf(buf + len, size - len, "%llu\t",
+				 arsta->tx_stats.total_bytes_nss[i]);
+	len += scnprintf(buf + len, size - len, "\nAMPDU bytes:  \t\t");
+	for (i = 0; i < VHT_NSS_NUM; i++)
+		len += scnprintf(buf + len, size - len, "%llu\t",
+				 arsta->tx_stats.ampdu_bytes_nss[i]);
+
+	len += scnprintf(buf + len, size - len,
+			"\nTX duration:\t %llu usecs\n", arsta->tx_stats.tx_duration);
+
+	len += scnprintf(buf + len, size - len,
+			"BA fails:\t %llu\n", arsta->tx_stats.ba_fails);
+
+	if (len > size)
+		len = size;
+	retval = simple_read_from_buffer(user_buf, count, ppos, buf, len);
+	kfree(buf);
+
+	return retval;
+}
+
+static const struct file_operations fops_tx_stats = {
