+	ath12k_get_peer_sla_config(peer->mlo ? stats->peer_mld_mac : stats->peer_link_mac,
+				   &stats->sla_mask);
 	rcu_read_unlock();
 	for (ac = 0; ac < ATH12K_DP_WLAN_MAX_AC; ac++) {
 		stats->airtime_consumption[ac] =
