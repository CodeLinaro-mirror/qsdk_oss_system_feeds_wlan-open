diff --git a/drivers/net/wireless/ath/ath10k/debug.c b/drivers/net/wireless/ath/ath10k/debug.c
index c6e68a1..d317e02 100644
--- a/drivers/net/wireless/ath/ath10k/debug.c
+++ b/drivers/net/wireless/ath/ath10k/debug.c
@@ -2604,6 +2604,44 @@ static const struct file_operations fops_ps_state_enable = {
 	.llseek = default_llseek,
 };
 
+#ifdef CPTCFG_ATH10K_QCA4531_PERF
+static ssize_t ath10k_write_htt_max_num_refill(struct file *file,
+					    const char __user *user_buf,
+					    size_t count, loff_t *ppos)
+{
+	struct ath10k *ar = file->private_data;
+	u8 htt_max_num_refill;
+
+	if (kstrtou8_from_user(user_buf, count, 0, &htt_max_num_refill))
+		return -EINVAL;
+
+	ar->htt.max_num_refill = htt_max_num_refill;
+
+	return count;
+}
+
+static ssize_t ath10k_read_htt_max_num_refill(struct file *file, char __user *user_buf,
+					   size_t count, loff_t *ppos)
+{
+	struct ath10k *ar = file->private_data;
+	int len = 0;
+	char buf[32];
+
+	len = scnprintf(buf, sizeof(buf) - len, "%d\n",
+			ar->htt.max_num_refill);
+
+	return simple_read_from_buffer(user_buf, count, ppos, buf, len);
+}
+
+static const struct file_operations fops_htt_max_num_refill = {
+	.read = ath10k_read_htt_max_num_refill,
+	.write = ath10k_write_htt_max_num_refill,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
+#endif
+
 int ath10k_debug_create(struct ath10k *ar)
 {
 	ar->debug.fw_crash_data = vzalloc(sizeof(*ar->debug.fw_crash_data));
@@ -2753,6 +2791,11 @@ int ath10k_debug_register(struct ath10k *ar)
 	debugfs_create_file("ps_state_enable", S_IRUSR | S_IWUSR,
 			    ar->debug.debugfs_phy, ar, &fops_ps_state_enable);
 
+#ifdef CPTCFG_ATH10K_QCA4531_PERF
+	debugfs_create_file("htt_max_num_refill", S_IRUSR | S_IWUSR,
+			    ar->debug.debugfs_phy, ar, &fops_htt_max_num_refill);
+#endif
+
 	return 0;
 }
 
diff --git a/drivers/net/wireless/ath/ath10k/htt.h b/drivers/net/wireless/ath/ath10k/htt.h
index 6074782..77b426a 100644
--- a/drivers/net/wireless/ath/ath10k/htt.h
