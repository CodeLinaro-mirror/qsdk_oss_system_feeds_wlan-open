+				tx_stats->ampdu_bytes_nss[nss] +=
+					__le16_to_cpu(peer_stats->success_bytes[i]) +
+					__le16_to_cpu(peer_stats->retry_bytes[i]);
+				tx_stats->ampdu_bytes_gi[gi] +=
+					__le16_to_cpu(peer_stats->success_bytes[i]) +
+					__le16_to_cpu(peer_stats->retry_bytes[i]);
+				tx_stats->ampdu_bytes_rate_num[idx] +=
+					__le16_to_cpu(peer_stats->success_bytes[i]) +
+					__le16_to_cpu(peer_stats->retry_bytes[i]);
+				tx_stats->ampdu_pkts_bw[bw] +=
