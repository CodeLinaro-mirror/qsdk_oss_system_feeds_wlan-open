From 355dbe9478238e213a2af77b999b87bfa579576f Mon Sep 17 00:00:00 2001
From: Karthik M <quic_karm@quicinc.com>
Date: Tue, 6 Dec 2022 16:03:03 +0530
Subject: [PATCH] ath11k : regdb separate binary support removal

lithium architecture no longer needed support for download of
separate regdb.bin. It will be encoded as part of board-2.bin.

Signed-off-by: Karthik M <quic_karm@quicinc.com>
---
 drivers/net/wireless/ath/ath11k/core.c | 12 +++---------
 drivers/net/wireless/ath/ath11k/qmi.c  |  6 +++---
 2 files changed, 6 insertions(+), 12 deletions(-)

diff --git a/drivers/net/wireless/ath/ath11k/core.c b/drivers/net/wireless/ath/ath11k/core.c
index 8c5e979..d91ccd5 100644
--- a/drivers/net/wireless/ath/ath11k/core.c
+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -1301,7 +1301,6 @@ int ath11k_core_fetch_regdb(struct ath11k_base *ab, struct ath11k_board_data *bd
 		return ret;
 	}
 
-	ab->bd_api = 2;
 	ret = ath11k_core_fetch_board_data_api_n(ab, bd, regdbname,
 			                         ATH11K_BD_IE_REGDB,
 						 ATH11K_BD_IE_REGDB_NAME,
@@ -1313,18 +1312,13 @@ int ath11k_core_fetch_regdb(struct ath11k_base *ab, struct ath11k_board_data *bd
 			                         ATH11K_BD_IE_REGDB,
 						 ATH11K_BD_IE_REGDB_NAME,
 						 ATH11K_BD_IE_REGDB_DATA);
-	if (!ret)
-		goto success;
-
-	ab->bd_api = 1;
-	ret = ath11k_core_fetch_board_data_api_1(ab, bd, ATH11K_REGDB_FILE_NAME);
 	if (ret) {
-		ath11k_err(ab, "failed to fetch %s file from %s\n",
-			   ATH11K_REGDB_FILE_NAME, ab->hw_params.fw.dir);
+		ath11k_err(ab, "failed to fetch %s file from board-2.bin\n",
+			   ATH11K_REGDB_FILE_NAME);
 		return ret;
 	}
 success:
-	ath11k_dbg(ab, ATH11K_DBG_BOOT, "using board api %d\n", ab->bd_api);
+	ath11k_dbg(ab, ATH11K_DBG_BOOT, "using board-2.bin\n");
 	return 0;
 }
 
diff --git a/drivers/net/wireless/ath/ath11k/qmi.c b/drivers/net/wireless/ath/ath11k/qmi.c
index e31ccc3..721f08d 100644
--- a/drivers/net/wireless/ath/ath11k/qmi.c
+++ b/drivers/net/wireless/ath/ath11k/qmi.c
@@ -4297,15 +4297,15 @@ static int ath11k_qmi_event_load_bdf(struct ath11k_qmi *qmi)
 		return ret;
 	}
 
-	if (ab->hw_params.supports_regdb)
-		ath11k_qmi_load_bdf_qmi(ab, true);
-
 	ret = ath11k_qmi_request_device_info(ab);
 	if (ret < 0) {
 		ath11k_warn(ab, "qmi failed to req device info %d\n", ret);
 		return ret;
 	}
 
+	if (ab->hw_params.supports_regdb && ab->qmi.target.regdb)
+		ath11k_qmi_load_bdf_qmi(ab, true);
+
 	ret = ath11k_qmi_load_bdf_qmi(ab, false);
 	if (ret < 0) {
 		ath11k_warn(ab, "failed to load board data file: %d\n", ret);
-- 
2.17.1

