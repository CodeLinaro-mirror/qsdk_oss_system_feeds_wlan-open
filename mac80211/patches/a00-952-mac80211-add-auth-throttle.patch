diff --git a/net/mac80211/ieee80211_i.h b/net/mac80211/ieee80211_i.h
index 97959ad..0cd3aaa 100644
--- a/net/mac80211/ieee80211_i.h
+++ b/net/mac80211/ieee80211_i.h
@@ -45,6 +45,8 @@ extern const struct cfg80211_ops mac80211_config_ops;
 
 struct ieee80211_local;
 
+#define AP_MAX_AUTH_PER_SECOND 30
+
 /* Maximum number of broadcast/multicast frames to buffer when some of the
  * associated stations are using power saving. */
 #define AP_MAX_BC_BUFFER 128
@@ -993,6 +995,10 @@ struct ieee80211_sub_if_data {
 	bool extsta_enabled;
 	struct extsta extsta;
 
+	spinlock_t auth_lock;
+	unsigned long auth_begin;
+	int auth_cnt;
+
 	/* must be last, dynamically sized area in this! */
 	struct ieee80211_vif vif;
 };
diff --git a/net/mac80211/iface.c b/net/mac80211/iface.c
index a74c1f6..6108ac4 100644
--- a/net/mac80211/iface.c
+++ b/net/mac80211/iface.c
@@ -1642,6 +1642,10 @@ static void ieee80211_setup_sdata(struct ieee80211_sub_if_data *sdata,
 	INIT_LIST_HEAD(&sdata->assigned_chanctx_list);
 	INIT_LIST_HEAD(&sdata->reserved_chanctx_list);
 
+	spin_lock_init(&sdata->auth_lock);
+	sdata->auth_cnt = 0;
+	sdata->auth_begin = 0;
+
 	switch (type) {
 	case NL80211_IFTYPE_P2P_GO:
 		type = NL80211_IFTYPE_AP;
diff --git a/net/mac80211/rx.c b/net/mac80211/rx.c
index 8237a72..17e3c6d 100644
--- a/net/mac80211/rx.c
+++ b/net/mac80211/rx.c
@@ -2933,6 +2933,34 @@ static void ieee80211_process_sa_query_req(struct ieee80211_sub_if_data *sdata,
 	ieee80211_tx_skb(sdata, skb);
 }
 
+static int ieee80211_drop_auth_ratelimit(struct ieee80211_rx_data *rx)
+{
+	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)rx->skb->data;
+	struct ieee80211_sub_if_data *sdata = rx->sdata;
+	int ret;
+
+	if (!ieee80211_is_auth(hdr->frame_control))
+		return 0;
+
+	spin_lock_bh(&sdata->auth_lock);
+
+	if (!sdata->auth_begin
+		|| time_is_before_jiffies(sdata->auth_begin + HZ)) {
+		sdata->auth_begin = jiffies;
+		sdata->auth_cnt = 0;
+	}
+
+	sdata->auth_cnt++;
+	if (sdata->auth_cnt <= AP_MAX_AUTH_PER_SECOND)
+		ret = 0;
+	else
+		ret = 1;
+
+	spin_unlock_bh(&sdata->auth_lock);
+
+	return ret;
+}
+
 static ieee80211_rx_result debug_noinline
 ieee80211_rx_h_mgmt_check(struct ieee80211_rx_data *rx)
 {
@@ -2968,6 +2996,10 @@ ieee80211_rx_h_mgmt_check(struct ieee80211_rx_data *rx)
 	if (ieee80211_drop_unencrypted_mgmt(rx))
 		return RX_DROP_UNUSABLE;
 
+        if (ieee80211_drop_auth_ratelimit(rx)) {
+                return RX_DROP_UNUSABLE;
+        }
+
 	return RX_CONTINUE;
 }
 
