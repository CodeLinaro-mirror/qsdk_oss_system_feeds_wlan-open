From 6ed5ecaa232579bd0b5e2e9d5d786638c5accc5c Mon Sep 17 00:00:00 2001
From: Pradeep Kumar Chitrapu <quic_pradeepc@quicinc.com>
Date: Mon, 28 Feb 2022 18:47:16 -0800
Subject: [PATCH 27/27] ath12k: workaround to match STA

Signed-off-by: Pradeep Kumar Chitrapu <quic_pradeepc@quicinc.com>
Signed-off-by: Aloka Dixit <quic_alokad@quicinc.com>
---
 include/linux/ieee80211.h | 25 +++++++++++++++----------
 net/mac80211/eht.c        | 10 ++++++----
 2 files changed, 21 insertions(+), 14 deletions(-)

diff --git a/include/linux/ieee80211.h b/include/linux/ieee80211.h
index 7f6d82e0f5fc..9a7440a4eeb1 100644
--- a/include/linux/ieee80211.h
+++ b/include/linux/ieee80211.h
@@ -2018,17 +2018,16 @@ struct ieee80211_eht_cap_elem {
 /**
  * struct ieee80211_eht_operation - eht operation element
  *
- * This structure is the "EHT Operation Element" fields as
- * described in P802.11be_D1.4 section 9.4.2.311
- *
- * FIXME: The spec is unclear how big the fields are, and doesn't
- *	  indicate the "Disabled Subchannel Bitmap Present" in the
- *	  structure (Figure 9-1002a) at all ...
  */
 struct ieee80211_eht_operation {
-	u8 chan_width;
-	u8 ccfs;
-	u8 present_bm;
+	u8 basic_mcs_nss_set[2];
+	u8 primary_channel;
+	u8 chan_width;//:3,
+		//present_bm:1,
+		//reserved:4;
+	u8 ccfs;//seg0
+	u8 rsvd;//seg1
+	u8 minimum_rate;
 
 	u8 disable_subchannel_bitmap[];
 } __packed;
@@ -2797,6 +2796,8 @@ ieee80211_he_spr_size(const u8 *he_spr_ie)
 #define IEEE80211_EHT_OPER_CHAN_WIDTH_160MHZ	3
 #define IEEE80211_EHT_OPER_CHAN_WIDTH_320MHZ	4
 
+#define IEEE80211_EHT_OPER_PRESENT_BM		0x8
+
 /* Calculate 802.11be EHT capabilities IE Tx/Rx EHT MCS NSS Support Field size */
 static inline u8
 ieee80211_eht_mcs_nss_size(const struct ieee80211_he_cap_elem *he_cap,
@@ -2868,6 +2869,9 @@ ieee80211_eht_capa_size_ok(const u8 *he_capa, const u8 *data, u8 len)
 	if (len < needed || !he_capa)
 		return false;
 
+	/* WAR: always set to true */
+	return true;
+
 	needed += ieee80211_eht_mcs_nss_size((const void *)he_capa,
 					     (const void *)data);
 	if (len < needed)
@@ -2898,7 +2902,8 @@ ieee80211_eht_oper_size_ok(const u8 *data, u8 len)
 	if (len < needed)
 		return false;
 
-	if (elem->present_bm & IEEE80211_EHT_OPER_DISABLED_SUBCHANNEL_BITMAP_PRESENT)
+//	if (elem->present_bm & IEEE80211_EHT_OPER_DISABLED_SUBCHANNEL_BITMAP_PRESENT)
+	if (u8_get_bits(elem->chan_width, IEEE80211_EHT_OPER_PRESENT_BM))
 		needed += 2;
 
 	return len >= needed;
diff --git a/net/mac80211/eht.c b/net/mac80211/eht.c
index 1c1643f20bb5..26ee8c40209a 100644
--- a/net/mac80211/eht.c
+++ b/net/mac80211/eht.c
@@ -15,7 +15,6 @@ ieee80211_eht_cap_ie_to_sta_eht_cap(struct ieee80211_sub_if_data *sdata,
 				    u8 eht_cap_len, struct sta_info *sta)
 {
 	struct ieee80211_sta_eht_cap *eht_cap = &sta->sta.eht_cap;
-	struct ieee80211_he_cap_elem *he_cap_ie_elem = (void *)he_cap_ie;
 	u8 eht_ppe_size = 0;
 	u8 mcs_nss_size;
 	u8 eht_total_size = sizeof(eht_cap->eht_cap_elem);
@@ -28,8 +27,11 @@ ieee80211_eht_cap_ie_to_sta_eht_cap(struct ieee80211_sub_if_data *sdata,
 					 ieee80211_vif_type_p2p(&sdata->vif)))
 		return;
 
-	mcs_nss_size = ieee80211_eht_mcs_nss_size(he_cap_ie_elem,
+	mcs_nss_size = eht_cap_len - sizeof(struct ieee80211_eht_cap_elem_fixed);
+	/* WAR: compute based on capabilities
+	 * mcs_nss_size = ieee80211_eht_mcs_nss_size(he_cap_ie_elem,
 						  &eht_cap_ie_elem->fixed);
+	 */
 
 	eht_total_size += mcs_nss_size;
 
@@ -82,7 +84,7 @@ void ieee80211_eht_op_ie_to_bss_conf(struct ieee80211_vif *vif,
 	if (!op_ie)
 		return;
 
-	vif->bss_conf.eht_oper.chan_width = op_ie->chan_width;
+	vif->bss_conf.eht_oper.chan_width = u8_get_bits(op_ie->chan_width, IEEE80211_EHT_OPER_CHAN_WIDTH);
 	vif->bss_conf.eht_oper.ccfs = op_ie->ccfs;
-	vif->bss_conf.eht_oper.present_bm = op_ie->present_bm;
+	vif->bss_conf.eht_oper.present_bm = u8_get_bits(op_ie->chan_width, IEEE80211_EHT_OPER_PRESENT_BM);
 }
-- 
