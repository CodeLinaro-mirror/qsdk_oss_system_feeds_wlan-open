+	case ATH10K_VOW_STATS_AMPDU_30:
+		return "21-30";
+	case ATH10K_VOW_STATS_AMPDU_40:
+		return "31-40";
+	case ATH10K_VOW_STATS_AMPDU_50:
+		return "41-50";
+	case ATH10K_VOW_STATS_AMPDU_60:
+		return "51-60";
+	case ATH10K_VOW_STATS_AMPDU_MORE:
+		return ">60";
+	case ATH10K_VOW_STATS_AMPDU_NUM_MAX:
+		return "0";
+	}
+
+	return "0";
+}
+
+static char *get_num_amsdu_subfrm_str(enum ath10k_vow_stats_amsdu i)
