diff --git a/drivers/net/wireless/ath/ath10k/debug.c b/drivers/net/wireless/ath/ath10k/debug.c
index bda87b1..dd9ede4 100644
--- a/drivers/net/wireless/ath/ath10k/debug.c
+++ b/drivers/net/wireless/ath/ath10k/debug.c
@@ -2752,9 +2752,6 @@ void ath10k_dbg_gen_bug_on_fw_assert(struct ath10k *ar)
 	int ret, i, num_read;
 	u8 *addr, *pos;
 
-	if (!bug_on_fw_assert)
-		return;
-
 	addr = (u8 *)ioremap(ATH10K_FW_IO_MEM_ADDR, ATH10K_FW_IO_MEM_SIZE);
 	if (!addr) {
 		ath10k_err(ar, "Cannot access memory to dump WLAN Firmware data\n");
@@ -3000,6 +2997,9 @@ void ath10k_dbg_ipq40xx_bug_on_fw_assert(struct ath10k *ar)
 
 void ath10k_dbg_bug_on_fw_assert(struct ath10k *ar)
 {
+	if (!bug_on_fw_assert || ar->stats.fw_crash_counter == 0)
+		return;
+
 	if (QCA_REV_99X0(ar))
 		ath10k_dbg_qca99x0_bug_on_fw_assert(ar);
 	else if (QCA_REV_40XX(ar))
diff --git a/drivers/net/wireless/ath/ath10k/mac.c b/drivers/net/wireless/ath/ath10k/mac.c
index 7de1bad..f9bafaa 100644
--- a/drivers/net/wireless/ath/ath10k/mac.c
+++ b/drivers/net/wireless/ath/ath10k/mac.c
@@ -3750,6 +3750,24 @@ ath10k_mac_tx_h_get_txmode(struct ath10k *ar,
 	    skb_cb->flags & ATH10K_SKB_F_RAW_TX)
 		return ATH10K_HW_TXRX_RAW;
 
+	/* Workaround:
+	 *
+	 * Since 10.4.3 (at least confirmed with 10.4.3-00191) for QCA99X0
+	 * MU-MIMO aggregation is broken with NativeWifi tx mode resulting in
+	 * poor performance. It is thought this is related to peer-flow-ctrl
+	 * feature. To make it work Ethernet tx mode is required.  Ethernet
+	 * can't carry 4addr information and the necessary prerequisites aren't
+	 * in place so these frames are excluded - it's more important to have
+	 * it working than working fast.
+	 */
+	if (QCA_REV_99X0(ar)) {
+		if (test_bit(ATH10K_FW_FEATURE_PEER_FLOW_CONTROL,
+		    ar->running_fw->fw_file.fw_features) &&
+		    ieee80211_is_data_present(fc) &&
+		    !ieee80211_has_a4(fc) && !ieee80211_vif_is_mesh(vif))
+			return ATH10K_HW_TXRX_ETHERNET;
+	}
+
 	return ATH10K_HW_TXRX_NATIVE_WIFI;
 }
 
