+	len += scnprintf(buf + len, size - len, "\nLEGACY RATE BYTES:\n");
+	len += scnprintf(buf + len, size - len, "Success bytes:\t\t");
+	for (i = 0; i < LEGACY_RATE_NUM; i++)
+		len += scnprintf(buf + len, size - len, "%llu\t",
+				 arsta->tx_stats.succ_bytes_legacy_rates[i]);
+	len += scnprintf(buf + len, size - len, "\nRetry bytes:  \t\t");
+	for (i = 0; i < LEGACY_RATE_NUM; i++)
+		len += scnprintf(buf + len, size - len, "%llu\t",
