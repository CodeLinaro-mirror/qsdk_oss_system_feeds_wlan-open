 	struct ath12k_pdev_wmi *wmi = ar->wmi;
 	struct wmi_vdev_create_cmd *cmd;
+	struct wmi_vdev_create_mlo_params *ml_params;
 	struct sk_buff *skb;
 	struct wmi_vdev_txrx_streams *txrx_streams;
