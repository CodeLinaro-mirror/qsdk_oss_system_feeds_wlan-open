+static ssize_t ath10k_dbg_sta_read_vow_stats(struct file *file,
+					     char __user *user_buf,
+					     size_t count, loff_t *ppos)
+{
+	struct ieee80211_sta *sta = file->private_data;
+	struct ath10k_sta *arsta = (struct ath10k_sta *)sta->drv_priv;
+	struct ath10k *ar = arsta->arvif->ar;
+	struct ath10k_vow_stats *stats;
+	size_t len = 0, buf_len = 2048;
+	char *buf;
+	int i;
+	ssize_t ret;
+
+	buf = kzalloc(buf_len, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	mutex_lock(&ar->conf_mutex);
+
+	spin_lock_bh(&ar->data_lock);
+
+	stats = &arsta->vow_stats;
+
+	len += scnprintf(buf + len, buf_len - len,
+			 "\t\tAth10k Rx Video pkt stats\n");
+	len += scnprintf(buf + len, buf_len - len,
+			 "\t\t=========================\n");
+	len += scnprintf(buf + len, buf_len - len,
+			 "MSDUs from FW\t\t\t\t\t%lu\n",
+			 stats->rx_pkt_from_fw);
+	len += scnprintf(buf + len, buf_len - len,
+			 "MSDUs unchained\t\t\t\t\t%lu\n",
+			 stats->rx_pkt_unchained);
+	len += scnprintf(buf + len, buf_len - len,
+			 "MSDUs locally dropped:chained\t\t\t%lu\n",
+			 stats->rx_pkt_drop_chained);
+	len += scnprintf(buf + len, buf_len - len,
+			 "MSDUs locally dropped:filtered\t\t\t%lu\n",
+			 stats->rx_pkt_drop_filter);
+	len += scnprintf(buf + len, buf_len - len,
+			 "MSDUs to mac80211\t\t\t\t%lu\n",
+			 stats->rx_pkt_to_mac);
+	for (i = 0; i < ATH10K_PKT_RX_ERR_MAX; i++) {
+		len += scnprintf(buf + len, buf_len - len,
+				 "MSDUs with error:%s\t\t\t%lu\n",
+			 get_err_str(i), stats->rx_pkt_err[i]);
+	}
+
+	len += scnprintf(buf + len, buf_len - len, "\n");
+	for (i = 0; i < ATH10K_VOW_STATS_AMPDU_NUM_MAX; i++) {
+		len += scnprintf(buf + len, buf_len - len,
+				 "A-MPDU num subframes %s\t\t\t%lu\n",
+				 get_num_ampdu_subfrm_str(i), stats->rx_pkt_ampdu[i]);
+	}
+
+	len += scnprintf(buf + len, buf_len - len, "\n");
+	for (i = 0; i < ATH10K_VOW_STATS_AMSDU_NUM_MAX; i++) {
+		len += scnprintf(buf + len, buf_len - len,
+				 "A-MSDU num subframes %s\t\t\t\t%lu\n",
+				 get_num_amsdu_subfrm_str(i), stats->rx_pkt_amsdu[i]);
+	}
+
+	spin_unlock_bh(&ar->data_lock);
+
+	ret = simple_read_from_buffer(user_buf, count, ppos, buf, len);
+
+	kfree(buf);
+
+	mutex_unlock(&ar->conf_mutex);
+
+	return ret;
+}
+
+static const struct file_operations fops_vow_stats_dump = {
+	.open = simple_open,
+	.read = ath10k_dbg_sta_read_vow_stats,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
+
