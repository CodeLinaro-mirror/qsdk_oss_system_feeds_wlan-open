 	struct ath12k_wmi_thermal_mitigation_arg param;
-	int ret = 0;
+	int level, ret;
 
 	lockdep_assert_held(&ar->conf_mutex);
 
@@ -137,14 +168,19 @@ int ath12k_thermal_set_throttling(struct
 
