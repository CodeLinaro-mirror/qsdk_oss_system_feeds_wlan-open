 			      struct ath12k_peer *peer, ktime_t timestamp);
 
-void ath12k_get_peer_sla_config(struct ath12k_peer *peer, u16 *sla_mask);
+void ath12k_get_peer_sla_config(const u8 *sta_addr, u16 *sla_mask);
 
 void ath12k_sawf_tx_enqueue_peer_stats(struct ath12k_base *ab,
 				       struct ath12k_peer *peer,
