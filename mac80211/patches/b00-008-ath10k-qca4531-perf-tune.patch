diff --git a/.local-symbols b/.local-symbols
index d872db9..96175ca 100644
--- a/.local-symbols
+++ b/.local-symbols
@@ -121,3 +121,4 @@ ATH10K_TRACING=
 ATH10K_DFS_CERTIFIED=
 ATH10K_PKTLOG=
 ATH10K_SMART_ANT_ALG=
+ATH10K_QCA4531_PERF=
diff --git a/drivers/net/wireless/ath/ath10k/Kconfig b/drivers/net/wireless/ath/ath10k/Kconfig
index f4aa629..ed87df5 100644
--- a/drivers/net/wireless/ath/ath10k/Kconfig
+++ b/drivers/net/wireless/ath/ath10k/Kconfig
@@ -70,3 +70,10 @@ config ATH10K_SMART_ANT_ALG
 	depends on ATH10K
 	---help---
 	This option enables smart antenna algorithm.
+
+config ATH10K_QCA4531_PERF
+	bool "QCA4531 PERF tuning"
+       depends on ATH10K
+       default n
+       ---help---
