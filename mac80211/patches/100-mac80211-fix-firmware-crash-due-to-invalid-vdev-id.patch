From 0a3365972184b1934e33379c6516985c8d83a70c Mon Sep 17 00:00:00 2001
From: Manikanta Pubbisetty <mpubbise@codeaurora.org>
Date: Thu, 19 Dec 2019 19:18:56 +0530
Subject: [PATCH 2/2] mac80211: monitor counter change

Signed-off-by: Manikanta Pubbisetty <mpubbise@codeaurora.org>
---
 net/mac80211/iface.c | 3 +++
 1 file changed, 3 insertions(+)

--- a/net/mac80211/iface.c
+++ b/net/mac80211/iface.c
@@ -1037,6 +1037,9 @@ static void ieee80211_do_stop(struct iee
 		if (local->monitors == 0)
 			ieee80211_del_virtual_monitor(local);
 
+		if (hw_reconf_flags)
+			drv_config(local, hw_reconf_flags);
+
 		mutex_lock(&local->mtx);
 		ieee80211_recalc_idle(local);
 		mutex_unlock(&local->mtx);
