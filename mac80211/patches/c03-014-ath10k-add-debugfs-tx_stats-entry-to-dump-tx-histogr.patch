diff --git a/drivers/net/wireless/ath/ath10k/debugfs_sta.c b/drivers/net/wireless/ath/ath10k/debugfs_sta.c
index aa9c789..d8f79dd 100644
--- a/drivers/net/wireless/ath/ath10k/debugfs_sta.c
