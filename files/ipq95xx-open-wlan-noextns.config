# Disable QCN extensions
# CONFIG_PACKAGE_QCN_EXTN is not set
# CONFIG_PACKAGE_QCN_EXTN_MESH_SUPPORT is not set
# CONFIG_PACKAGE_QCA_LAB_TEST_FEATURES is not set

# CONFIG_WPA_MQTT_SUPPORT is not set

# Put no-extension hostapd in the rootfs
# CONFIG_PACKAGE_wpad-mesh-openssl is not set
CONFIG_PACKAGE_wpad-mesh-openssl-noextns=y

# Use the matching no-extension utilities
# CONFIG_PACKAGE_hostapd-utils is not set
CONFIG_PACKAGE_hostapd-utils-noextns=y

# Use the no-extension ath12k driver in the rootfs
# CONFIG_PACKAGE_kmod-ath12k is not set
CONFIG_PACKAGE_kmod-ath12k-noextns=y

# Not compatible with the noextns ath12k selection
# CONFIG_PACKAGE_kmod-qca-wifi-nss-plugins is not set

# qca-rptr-mgr requires the regular QCN-enabled hostapd
# CONFIG_PACKAGE_qca-rptr-mgr is not set

# Disable macsec hostapd variants in this noextns profile
# CONFIG_PACKAGE_wpad-macsec is not set
# CONFIG_PACKAGE_wpad-macsec-noextns is not set
