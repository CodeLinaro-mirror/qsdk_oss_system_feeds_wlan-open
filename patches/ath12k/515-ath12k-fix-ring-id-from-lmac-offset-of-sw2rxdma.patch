From a5576fb4ac5c5f4c37e755cce24891b530792590 Mon Sep 17 00:00:00 2001
From: Aishwarya R <quic_aisr@quicinc.com>
Date: Tue, 22 Feb 2022 20:22:01 +0530
Subject: [PATCH] ath12k: fix ring id from lmac offset of sw2rxdma

Signed-off-by: Aishwarya R <quic_aisr@quicinc.com>
---
 drivers/net/wireless/ath/ath12k/dp_tx.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/dp_tx.c b/drivers/net/wireless/ath/ath12k/dp_tx.c
index dcdae3b..1b69f3e 100644
--- a/drivers/net/wireless/ath/ath12k/dp_tx.c
+++ b/drivers/net/wireless/ath/ath12k/dp_tx.c
@@ -687,8 +687,8 @@ ath12k_dp_tx_get_ring_id_type(struct ath12k_base *ab,
 		 * rxbuf ring for each rxdma
 		 */
 		if (!ab->hw_params->rx_mac_buf_ring) {
-			if (!(ring_id == HAL_SRNG_SW2RXDMA_BUF0 ||
-			      ring_id == HAL_SRNG_SW2RXDMA_BUF1)) {
+			if (!(ring_id == HAL_SRNG_SW2RXDMA_BUF0) ||
+			      (ring_id == HAL_SRNG_SW2RXDMA_BUF1)) {
 				ret = -EINVAL;
 			}
 			*htt_ring_id = HTT_RXDMA_HOST_BUF_RING;
-- 
2.17.1

