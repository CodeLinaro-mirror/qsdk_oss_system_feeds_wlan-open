From 03dd1aa5aaace24f2ebd75e55ad7a8effe9fcfb5 Mon Sep 17 00:00:00 2001
From: Aloka Dixit <quic_alokad@quicinc.com>
Date: Wed, 8 Dec 2021 13:52:25 -0800
Subject: [PATCH 6/7] ath12k: configure RU puncturing bitmap

Configure the RU puncturing bitmap as part of VDEV start/restart
and peer association commands in AP mode.

Signed-off-by: Aloka Dixit <quic_alokad@quicinc.com>
---
 drivers/net/wireless/ath/ath12k/mac.c | 2 ++
 drivers/net/wireless/ath/ath12k/wmi.c | 2 ++
 drivers/net/wireless/ath/ath12k/wmi.h | 9 ++++++++-
 3 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/drivers/net/wireless/ath/ath12k/mac.c b/drivers/net/wireless/ath/ath12k/mac.c
index 437a876000a5..6c37f7ee9559 100644
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -2192,6 +2192,7 @@ static void ath12k_peer_assoc_h_eht(struct ath12k *ar,
 	max_nss = max(max_nss, (uint8_t)eht_nss);
 
 	arg->peer_nss = min(sta->rx_nss, max_nss);
+	arg->ru_punct_bitmap = ~def.ru_punct_bitmap;
 
 	ath12k_dbg(ar->ab, ATH12K_DBG_MAC,
 		   "mac he peer %pM nss %d mcs cnt %d\n",
@@ -6377,6 +6378,7 @@ ath12k_mac_vdev_start_restart(struct ath12k_vif *arvif,
 	arg.channel.max_power = chandef->chan->max_power * 2;
 	arg.channel.max_reg_power = chandef->chan->max_reg_power * 2;
 	arg.channel.max_antenna_gain = chandef->chan->max_antenna_gain * 2;
+	arg.ru_punct_bitmap = ~chandef->ru_punct_bitmap;
 
 	arg.pref_tx_streams = ar->num_tx_chains;
 	arg.pref_rx_streams = ar->num_rx_chains;
diff --git a/drivers/net/wireless/ath/ath12k/wmi.c b/drivers/net/wireless/ath/ath12k/wmi.c
index 38efa75e8720..ad843ce62402 100644
--- a/drivers/net/wireless/ath/ath12k/wmi.c
+++ b/drivers/net/wireless/ath/ath12k/wmi.c
@@ -935,6 +935,7 @@ int ath12k_wmi_vdev_start(struct ath12k *ar, struct wmi_vdev_start_req_arg *arg,
 	cmd->cac_duration_ms = arg->cac_duration_ms;
 	cmd->regdomain = arg->regdomain;
 	cmd->he_ops = arg->he_ops;
+	cmd->ru_punct_bitmap = arg->ru_punct_bitmap;
 
 	if (!restart) {
 		if (arg->ssid) {
@@ -1897,6 +1898,7 @@ int ath12k_wmi_send_peer_assoc_cmd(struct ath12k *ar,
 
 	cmd->peer_new_assoc = param->peer_new_assoc;
 	cmd->peer_associd = param->peer_associd;
+	cmd->ru_punct_bitmap = param->ru_punct_bitmap;
 
 	ath12k_wmi_copy_peer_flags(cmd, param,
 				   test_bit(ATH12K_FLAG_HW_CRYPTO_DISABLED,
diff --git a/drivers/net/wireless/ath/ath12k/wmi.h b/drivers/net/wireless/ath/ath12k/wmi.h
index aa62b3572895..a25c60f299eb 100644
--- a/drivers/net/wireless/ath/ath12k/wmi.h
+++ b/drivers/net/wireless/ath/ath12k/wmi.h
@@ -2726,6 +2726,11 @@ struct wmi_vdev_start_request_cmd {
 	u32 he_ops;
 	u32 cac_duration_ms;
 	u32 regdomain;
+	u32 min_data_rate;
+	u32 mbss_capability_flags;
+	u32 vdevid_trans;
+	u32 eht_ops;
+	u32 ru_punct_bitmap;
 } __packed;
 
 #define MGMT_TX_DL_FRM_LEN		     64
@@ -2922,6 +2927,7 @@ struct wmi_vdev_start_req_arg {
 	u32 pref_rx_streams;
 	u32 pref_tx_streams;
 	u32 num_noa_descriptors;
+	u32 ru_punct_bitmap;
 };
 
 struct peer_create_params {
@@ -3799,6 +3805,7 @@ struct peer_assoc_params {
 	u32 peer_eht_tx_mcs_set[WMI_MAX_EHTCAP_RATE_SET];
 	u32 peer_eht_ops;
 	struct ath12k_ppe_threshold peer_eht_ppet;
+	u32 ru_punct_bitmap;
 };
 
 struct  wmi_peer_assoc_complete_cmd {
@@ -3834,7 +3841,7 @@ struct  wmi_peer_assoc_complete_cmd {
 	u32 bss_max_idle_option;
 	u32 auth_mode;
 	u32 peer_flags_ext;
-	u32 puncture_20mhz_bitmap;
+	u32 ru_punct_bitmap;
 	u32 peer_eht_cap_mac[WMI_MAX_EHTCAP_MAC_SIZE];
 	u32 peer_eht_cap_phy[WMI_MAX_EHTCAP_PHY_SIZE];
 	u32 peer_eht_ops;
-- 
2.31.1

