@@ -251,6 +251,7 @@ int ath12k_get_peer_stats(void *obj, str
 	}
 
 	rcu_read_lock();
+
 	peer = ath12k_peer_find_by_peer_list_index(pdev->ar, peer_db->peer_id);
 	if (!peer) {
 		rcu_read_unlock();
@@ -282,8 +283,8 @@ int ath12k_get_peer_stats(void *obj, str
 	}
 
 	stats->rssi = ath12k_calculate_link_rssi(peer);
-	if (peer->primary_link)
