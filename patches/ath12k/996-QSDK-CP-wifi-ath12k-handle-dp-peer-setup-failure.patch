From f3c29b9d4b301008772439cc02efbdac9aaa9ca7 Mon Sep 17 00:00:00 2001
From: Harshitha Prem <quic_hprem@quicinc.com>
Date: Thu, 2 Jan 2025 15:55:49 +0530
Subject: [PATCH] QSDK:CP:wifi:ath12k: handle dp peer setup failure

Even when peer is not found during dp peer setup, sta state machine
is trying to send the peer assoc command which leads to a null pointer
crash as the sta entry is not available in driver.

Handle failure case for dp peer setup and add debug logs in case
of peer link removal.

Signed-off-by: Harshitha Prem <quic_hprem@quicinc.com>
---
 drivers/net/wireless/ath/ath12k/mac.c | 31 ++++++++++++++++++++++-----
 1 file changed, 26 insertions(+), 5 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/mac.c b/drivers/net/wireless/ath/ath12k/mac.c
index 833e471..ce84a9b 100644
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -8877,7 +8877,7 @@ int ath12k_mac_create_bridge_peer(struct ath12k_hw *ah, struct ath12k_sta *ahsta
 	mutex_lock(&ar->conf_mutex);
 	ret = ath12k_mac_station_add(ar, arvif, arsta);
 	if (ret) {
-		ath12k_warn(ar->ab, "Failed to add station: %pM for VDEV: %d\n",
+		ath12k_warn(ar->ab, "Failed to add bridge station: %pM for VDEV: %d\n",
 			    arsta->addr, arvif->vdev_id);
 		ath12k_mac_free_unassign_link_sta(ah, ahsta, link_id);
 	}
@@ -8974,9 +8974,12 @@ static int ath12k_mac_station_remove(struct ath12k *ar,
 exit:
 	ath12k_cfr_decrement_peer_count(ar, arsta);
 
-	if (sta->valid_links)
+	if (sta->valid_links) {
+		ath12k_dbg(ar->ab, ATH12K_DBG_PEER, "unassign link id %d for sta %pM",
+			   arsta->link_id, sta->addr);
 		ath12k_mac_free_unassign_link_sta(arvif->ahvif->ah,
 						  arsta->ahsta, arsta->link_id);
+	}
 
  	return ret;
 }
@@ -9035,6 +9038,8 @@ static void ath12k_mac_ml_station_remove(struct ath12k_vif *ahvif,
 			ath12k_mac_dec_num_stations(arvif, arsta);
 		}
 
+		ath12k_dbg(ar->ab, ATH12K_DBG_PEER, "unassign link sta %pM with link id %d\n",
+			   arsta->addr, link_id);
 		ath12k_mac_free_unassign_link_sta(ah, ahsta, link_id);
 	}
 
@@ -9103,9 +9108,11 @@ static int ath12k_mac_handle_link_sta_state(struct ieee80211_hw *hw,
 		    new_state == IEEE80211_STA_ASSOC) {
 
 		ret = ath12k_dp_peer_setup(ar, arvif, arsta);
-		if (ret)
+		if (ret) {
 			ath12k_warn(ar->ab, "failed to setup dp for peer %pM on vdev %i (%d)\n",
 					arsta->addr, arvif->vdev_id, ret);
+			goto out;
+		}
 
 		ath12k_dp_peer_default_route_setup(ar, arvif, arsta);
 
@@ -9147,6 +9154,7 @@ static int ath12k_mac_handle_link_sta_state(struct ieee80211_hw *hw,
 				    arsta->addr);
 	}
 
+out:
 	mutex_unlock(&ar->conf_mutex);
 
 	ath12k_dbg(ar->ab, ATH12K_DBG_PEER, "mac sta %pM old state %d new state :%d\n",
@@ -9466,6 +9474,8 @@ int ath12k_mac_update_sta_state(struct ieee80211_hw *hw,
 			if (ret)
 				ath12k_err(arvif->ar->ab, "Removed STA %pM for vdev %d with an error: %d.\n",
 					    arsta->addr, arvif->vdev_id, ret);
+			ath12k_dbg(arvif->ar->ab, ATH12K_DBG_PEER, "Remove non-ML sta %pM",
+				   arsta->addr);
 			mutex_unlock(&arvif->ar->conf_mutex);
 		} else {
 			ret = ath12k_mac_handle_link_sta_state(hw, arvif, arsta,
@@ -9627,6 +9637,9 @@ int ath12k_mac_update_sta_state(struct ieee80211_hw *hw,
 				/* Unassign this link sta which couldnt be added to FW and
 				 * cleanup the other link stations added earlier
 				 */
+				ath12k_dbg(arvif->ar->ab, ATH12K_DBG_PEER, "unassign sta %pM with link id %d\n",
+					   sta->addr, link_id);
+
 				ath12k_mac_free_unassign_link_sta(ah, ahsta, link_id);
 				ath12k_mac_ml_station_remove(ahvif, ahsta);
 			}
@@ -9792,11 +9805,13 @@ static int ath12k_mac_op_change_sta_links(struct ieee80211_hw *hw,
 				continue;
 			}
 
+			ath12k_dbg(ar->ab, ATH12K_DBG_PEER, "change sta %pM link_id %d",
+				   sta->addr, link_id);
 			mutex_lock(&ar->conf_mutex);
 			ret = ath12k_mac_station_add(ar, arvif, arsta);
 			if (ret) {
 				mutex_unlock(&ar->conf_mutex);
-				ath12k_warn(ar->ab, "Failed to add station: %pM for VDEV: %d\n",
+				ath12k_warn(ar->ab, "Failed to add change station: %pM for VDEV: %d\n",
 					    arsta->addr, arvif->vdev_id);
 				ath12k_mac_free_unassign_link_sta(ah, ahsta, link_id);
 				break;
@@ -9869,12 +9884,18 @@ static int ath12k_mac_op_change_sta_links(struct ieee80211_hw *hw,
 				ath12k_warn(ar->ab, "Failed to unauth/disassoc station: %pM for VDEV: %d\n",
 					    arsta->addr, arvif->vdev_id);
 
-				if (test_bit(ATH12K_FLAG_RECOVERY, &arvif->ar->ab->ag->dev_flags))
+				if (test_bit(ATH12K_FLAG_RECOVERY, &arvif->ar->ab->ag->dev_flags)) {
+					ath12k_dbg(ar->ab, ATH12K_DBG_PEER, " unassign link sta %pM of link %d\n",
+						   arsta->addr, arsta->link_id);
 					ath12k_mac_free_unassign_link_sta(arvif->ahvif->ah, arsta->ahsta, arsta->link_id);
+				}
 
 				skip_remove_sta = true;
 			}
 
+			ath12k_dbg(ar->ab, ATH12K_DBG_PEER, "Remove %s station of %pM link_id %d skip_remove %d\n",
+				   sta->mlo ? "ML" : "Non-ML", sta->addr, link_id, skip_remove_sta);
+ 
 			if (!skip_remove_sta && ath12k_mac_station_remove(ar, arvif, arsta)) {
 				ath12k_warn(ar->ab, "Failed to remove station: %pM for VDEV: %d\n",
 					    sta->addr, arvif->vdev_id);
-- 
2.34.1

