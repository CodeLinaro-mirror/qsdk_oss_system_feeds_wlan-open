+static u16
+ath11k_peer_assoc_h_he_limit(u16 tx_mcs_set,
+			     const u16 he_mcs_limit[NL80211_HE_NSS_MAX],
+			     const struct ieee80211_sta_he_cap *he_cap,
+			     struct peer_assoc_params *arg)
+{
+	int idx_limit;
+	int nss;
+	u16 mcs_map;
+	u16 mcs;
+
+	for (nss = 0; nss < NL80211_HE_NSS_MAX; nss++) {
+		mcs_map = ath11k_mac_get_max_he_mcs_map(tx_mcs_set, nss) &
+			  he_mcs_limit[nss];
+
+		if (mcs_map)
+			idx_limit = fls(mcs_map) - 1;
+		else
+			idx_limit = -1;
+
+		switch (idx_limit) {
+		case 0: /* fall through */
+		case 1: /* fall through */
+		case 2: /* fall through */
+		case 3: /* fall through */
+		case 4: /* fall through */
+		case 5: /* fall through */
+		case 6: /* fall through */
+		case 7:
+			mcs = IEEE80211_HE_MCS_SUPPORT_0_7;
+			break;
+		case 8:
+		case 9:
+			mcs = IEEE80211_HE_MCS_SUPPORT_0_9;
+			break;
+		case 10:
+		case 11:
+			mcs = IEEE80211_HE_MCS_SUPPORT_0_11;
+			break;
+		default:
+			WARN_ON(1);
+			/* fall through */
+		case -1:
+			mcs = IEEE80211_HE_MCS_NOT_SUPPORTED;
+			/* Disable MU operation when user disables all mcs rates
+			 * in NSS0 or NSS1
+			 */
+			if ((nss == 0 || nss == 1) &&
+			    he_cap->he_cap_elem.phy_cap_info[HECAP_PHYDWORD_4] &
+			    IEEE80211_HE_PHY_CAP4_SU_BEAMFORMEE) {
+				arg->peer_vht_caps &=
+					~IEEE80211_VHT_CAP_MU_BEAMFORMEE_CAPABLE;
+				arg->peer_he_cap_macinfo_internal |=
+					IEEE80211_HE_DL_MU_SUPPORT_DISABLE <<
+						IEEE80211_HE_DL_MUMIMO_SUPP_S;
+			}
+
+			break;
+		}
+
+		tx_mcs_set &= ~(0x3 << (nss * 2));
+		tx_mcs_set |= mcs << (nss * 2);
+	}
+
+	return tx_mcs_set;
+}
