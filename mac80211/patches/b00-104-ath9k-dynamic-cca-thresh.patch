diff --git a/drivers/net/wireless/ath/ath9k/debug.c b/drivers/net/wireless/ath/ath9k/debug.c
index 03799a8..d346a5c 100644
--- a/drivers/net/wireless/ath/ath9k/debug.c
+++ b/drivers/net/wireless/ath/ath9k/debug.c
@@ -1276,6 +1276,57 @@ static const struct file_operations fops_chutil = {
 	.llseek = default_llseek,
 };
 
+static ssize_t read_file_min_cca_thresh(struct file *file, char __user *user_buf,
+				size_t count, loff_t *ppos)
+{
+	struct ath_softc *sc = file->private_data;
+	s16 min_cca_reg, min_cca_usr;
+	char buf[64];
+	size_t retval, size;
+	u32 len = 0;
+
+	min_cca_reg = ath9k_hw_get_reg_min_cca_thr(sc->sc_ah);
+	min_cca_usr = ath9k_hw_get_usr_min_cca_thr(sc->sc_ah);
+
+	size = sizeof(buf);
+	len += scnprintf(buf + len, size - len, "%d %d\n", (int)min_cca_usr, (int)min_cca_reg);
+
+	retval = simple_read_from_buffer(user_buf, count, ppos, buf, len);
+
+	return retval;
+}
+
+static ssize_t write_file_min_cca_thresh(struct file *file, const char __user *user_buf,
+			      size_t count, loff_t *ppos)
+{
+	struct ath_softc *sc = file->private_data;
+	s16 val;
+	char buf[32];
+	ssize_t len;
+
+	len = min(count, sizeof(buf) - 1);
+	if (copy_from_user(buf, user_buf, len))
+		return -EFAULT;
+
+	buf[len] = '\0';
+	if (kstrtos16(buf, 0, &val))
+		return -EINVAL;
+
+	if (val < -110 || val > 0)
+		return -EINVAL;
+
+	ath9k_hw_set_usr_min_cca_thr(sc->sc_ah, val);
+	return count;
+}
+
+static const struct file_operations fops_min_cca_thresh = {
+	.read = read_file_min_cca_thresh,
+	.write = write_file_min_cca_thresh,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
+
 /* Ethtool support for get-stats */
 
 #define AMKSTR(nm) #nm "_BE", #nm "_BK", #nm "_VI", #nm "_VO"
@@ -1489,6 +1540,8 @@ int ath9k_init_debug(struct ath_hw *ah)
 			    sc->debug.debugfs_phy, sc, &fops_tpc);
 	debugfs_create_file("chutil", S_IRUSR | S_IWUSR,
 			    sc->debug.debugfs_phy, sc, &fops_chutil);
+	debugfs_create_file("min_cca_thresh", S_IRUSR | S_IWUSR,
+			    sc->debug.debugfs_phy, sc, &fops_min_cca_thresh);
 
 	return 0;
 }
