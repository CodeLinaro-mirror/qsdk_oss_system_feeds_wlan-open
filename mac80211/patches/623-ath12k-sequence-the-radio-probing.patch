From 4da5955a5166cec9ffbfa6ea19de05f626930dc2 Mon Sep 17 00:00:00 2001
From: Aishwarya R <quic_aisr@quicinc.com>
Date: Mon, 18 Apr 2022 13:01:58 +0530
Subject: [PATCH] ath12k: sequence the radio probing

mac80211 is assiging wiphy idx based on the radio probing, during
the simultaneous wiphy idx is assigned randomly for each radios without
maintaining the order.

Sequencing the wiphy idx to maintain the probing order by waiting for
the completion of previous radio probe.

Signed-off-by: Aishwarya R <quic_aisr@quicinc.com>
---
 drivers/net/wireless/ath/ath12k/core.c | 1 +
 drivers/net/wireless/ath/ath12k/core.h | 3 +++
 drivers/net/wireless/ath/ath12k/mac.c  | 3 +++
 drivers/net/wireless/ath/ath12k/pci.c  | 5 +++++
 4 files changed, 12 insertions(+)

diff --git a/drivers/net/wireless/ath/ath12k/core.c b/drivers/net/wireless/ath/ath12k/core.c
index 6c20d22..640af5c 100644
--- a/drivers/net/wireless/ath/ath12k/core.c
+++ b/drivers/net/wireless/ath/ath12k/core.c
@@ -1012,6 +1012,7 @@ struct ath12k_base *ath12k_core_alloc(struct device *dev, size_t priv_size,
 		return NULL;
 
 	init_completion(&ab->driver_recovery);
+	init_completion(&ab->probe_seq_done);
 
 	ab->workqueue = create_singlethread_workqueue("ath12k_wq");
 	if (!ab->workqueue)
diff --git a/drivers/net/wireless/ath/ath12k/core.h b/drivers/net/wireless/ath/ath12k/core.h
index 1dc9ad8..7626f78 100644
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -49,6 +49,7 @@ extern unsigned int ath12k_frame_mode;
 #define ATH12K_RECOVER_START_TIMEOUT_HZ		(20 * HZ)
 
 #define INVALID_CIPHER 0xFFFFFFFF
+#define ATH12K_RADIO_PROBE_SEQ_TIMEOUT_HZ		(2 * HZ)
 
 enum ath12k_supported_bw {
 	ATH12K_BW_20	= 0,
@@ -849,6 +850,8 @@ struct ath12k_base {
 	} stats;
 	u32 pktlog_defs_checksum;
 
+	struct completion probe_seq_done;
+
 	struct ath12k_dbring_cap *db_caps;
 	u32 num_db_cap;
 
diff --git a/drivers/net/wireless/ath/ath12k/mac.c b/drivers/net/wireless/ath/ath12k/mac.c
index f04dbd7..b563216 100644
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -8661,6 +8661,9 @@ int ath12k_mac_allocate(struct ath12k_base *ab)
 		clear_bit(ATH12K_FLAG_MONITOR_ENABLED, &ar->monitor_flags);
 	}
 
+	complete(&ab->probe_seq_done);
+	ath12k_dbg(ab, ATH12K_DBG_BOOT, "ath12k radio probe sequence wakeup\n");
+
 	return 0;
 
 err_free_mac:
diff --git a/drivers/net/wireless/ath/ath12k/pci.c b/drivers/net/wireless/ath/ath12k/pci.c
index 225ad2e..b818b2c 100644
--- a/drivers/net/wireless/ath/ath12k/pci.c
+++ b/drivers/net/wireless/ath/ath12k/pci.c
@@ -1299,6 +1299,11 @@ static int ath12k_pci_probe(struct pci_dev *pdev,
 	pci_set_drvdata(pdev, ab);
 	spin_lock_init(&ab_pci->window_lock);
 
+	if (!wait_for_completion_timeout(&ab->probe_seq_done,
+                                         ATH12K_RADIO_PROBE_SEQ_TIMEOUT_HZ)) {
+                ath12k_dbg(ab, ATH12K_DBG_BOOT, "ath12k radio probe sequence timeout\n");
+	}
+
 	/* Set fixed_mem_region to true for platforms support reserved memory
 	 * from DT. If memory is reserved from DT for FW, ath11k driver need not
 	 * allocate memory.
-- 
2.17.1

